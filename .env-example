APP_ENV=development
APP_NAME=VLO
APP_URL=http://localhost:3000

# Database: SQLite path, or postgres:// / mysql:// URL
DATABASE_URL=./vlo_app.db
#DB_DRIVER=sqlite
#DB_SCHEMA=schema.sql

# Server (HOST/PORT take precedence over VLO_HOST/VLO_PORT)
HOST=127.0.0.1
PORT=3000
#VLO_MAX_UPLOAD_MB=10

# Only enable behind a trusted reverse proxy that sets X-Forwarded-For
#VLO_TRUST_PROXY=false

# Features (comma-separated). Default:
# auth,database,api,modules,email,sse,files,flash,pagination,directives
#VLO_FEATURES=auth,database,api,modules,email,sse,files,flash,pagination,directives

# Auth — required when the auth feature is enabled.
# SESSION_SECRET must be at least 32 characters and never committed.
SESSION_SECRET=
#AUTH_COOKIE_SECURE=true
#AUTH_COOKIE=vlo_session
#AUTH_USER_TABLE=users
#AUTH_USER_ID=id
#AUTH_USER_IDENTIFIER=email
#AUTH_USER_PASSWORD=password_hash
#AUTH_USER_NAME=name
#AUTH_USER_EMAIL=email
#AUTH_USER_ROLE=role
#AUTH_USER_STATUS=status
#AUTH_SESSION_TABLE=sessions
#AUTH_SESSION_TOKEN=token
#AUTH_SESSION_USER_ID=user_id
#AUTH_SESSION_EXPIRES_AT=expires_at
#AUTH_SESSION_LIFETIME=86400

# Optional: extra public API routes (default is deny-all).
# Only add routes that are safe for anonymous access.
#AUTH_API_PUBLIC_ROUTES=/api/products,/api/products/*

# Email (optional)
#MAIL_ENABLED=true
#MAIL_DRIVER=smtp
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=no-reply@example.com
#MAIL_TLS=true
