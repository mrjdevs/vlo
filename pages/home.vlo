    color: #777;
    font-size: 0.8rem;
}
.features {
    max-width: 1200px;
    margin: 0 auto;
    padding: 90px 20px;
}
.section-heading {
    max-width: 700px;
    margin: 0 auto 50px;
    text-align: center;
}
.section-heading h2 {
    margin: 12px 0;
    font-size: 2.3rem;
    letter-spacing: -0.035em;
}
.section-heading p {
    margin: 0;
    color: #888;
    line-height: 1.7;
}
.feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}
.feature {
    min-height: 190px;
    padding: 28px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    transition: transform 0.2s ease, border-color 0.2s ease;
}
.feature:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
}
