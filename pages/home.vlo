    gap: 13px;
}
.workflow-points div {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
}
.workflow-points span {
    color: var(--primary);
    font-family: monospace;
    font-size: 0.8rem;
}
.workflow-points strong {
    font-size: 0.9rem;
}
.code-window {
    overflow: hidden;
    border: 1px solid #292929;
    border-radius: 12px;
    background: #09090a;
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
}
.window-bar {
    height: 42px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
