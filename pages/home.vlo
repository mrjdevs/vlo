    margin: 0 0 9px;
    font-size: 1.05rem;
}
.feature p {
    margin: 0;
    color: #888;
    line-height: 1.65;
    font-size: 0.9rem;
}
.workflow {
    padding: 100px 20px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: #0d0d0f;
}
.workflow-content {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
