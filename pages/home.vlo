}
.architecture-card code {
    display: block;
    color: var(--primary);
    font-size: 0.72rem;
    word-break: break-all;
}
.cta-section {
    padding: 110px 20px 130px;
    text-align: center;
}
.cta-section h2 {
    margin: 12px 0;
    font-size: 2.7rem;
    letter-spacing: -0.04em;
}
.cta-section > p {
    max-width: 600px;
    margin: 0 auto;
    color: #888;
    line-height: 1.7;
}
.cta-buttons {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
}
.cta-note {
    margin-top: 22px;
    color: #555;
    font-size: 0.75rem;
}
@media (max-width: 900px) {
    .feature-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .architecture-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .workflow-content {
        grid-template-columns: 1fr;
        gap: 45px;
    }
}
@media (max-width: 650px) {
    .intro h2,
    .cta-section h2 {
        font-size: 2rem;
    }
    .stats {
        grid-template-columns: repeat(2, 1fr);
    }
    .feature-grid,
    .architecture-grid {
        grid-template-columns: 1fr;
    }
    .features,
    .architecture,
    .workflow {
        padding-top: 70px;
        padding-bottom: 70px;
    }
    .cta-buttons {
        flex-direction: column;
        align-items: center;
    }
}
</style>