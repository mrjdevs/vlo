    font-size: 0.72rem;
}
.code-window pre {
    margin: 0;
    padding: 28px;
    overflow-x: auto;
}
.code-window code {
    color: #ccc;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.82rem;
    line-height: 1.8;
}
.architecture {
    max-width: 1100px;
    margin: 0 auto;
    padding: 100px 20px;
}
.architecture-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}
.architecture-card {
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
}
.architecture-icon {
    display: block;
