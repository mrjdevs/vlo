<script server>
{
  "get_users": "SELECT id, name, email, role FROM users ORDER BY id DESC LIMIT {{limit}} OFFSET {{offset}};",
  "get_users_count": "SELECT COUNT(*) as total FROM users;",
  "post_users": "INSERT INTO users (name, email, role) VALUES ({{name}}, {{email}}, {{role}}); SELECT * FROM users ORDER BY id DESC;",
  "put_users": "UPDATE users SET name = {{name}}, email = {{email}}, role = {{role}} WHERE id = {{id}}; SELECT * FROM users ORDER BY id DESC;",
  "patch_users": "UPDATE users SET name = {{name}}, email = {{email}}, role = {{role}} WHERE id = {{id}}; SELECT * FROM users ORDER BY id DESC;",
  "delete_users": "DELETE FROM users WHERE id = {{id}}; SELECT * FROM users ORDER BY id DESC;",


  "get_products": "SELECT * FROM products ORDER BY id DESC LIMIT {{limit}} OFFSET {{offset}};",
  "get_product": "SELECT * FROM products WHERE id = {{id}} LIMIT 1;",
  "get_products_count": "SELECT COUNT(*) as total FROM products;",
  "post_products": "INSERT INTO products (title, description, price, stock) VALUES ({{title}}, {{description}}, {{price}}, {{stock}}); SELECT * FROM products ORDER BY id DESC;",
  "put_products": "UPDATE products SET title = {{title}}, description = {{description}}, price = {{price}}, stock = {{stock}}, images={{images}} WHERE id = {{id}}; SELECT * FROM products ORDER BY id DESC;",
  "patch_products": "UPDATE products SET title = {{title}}, description = {{description}}, price = {{price}}, stock = {{stock}}, images = {{images}} WHERE id = {{id}}; SELECT * FROM products ORDER BY id DESC;",

  "delete_products": {"sql": "DELETE FROM products WHERE id = {{id}}", "roles": ["Admin", "User"]},
  "update_product": {"sql": "UPDATE products SET title = {{title}}, price = {{price}} WHERE id = {{id}}","roles": ["Admin", "Editor"]},

  "get_test_multi": "SELECT 1 AS first_stmt; SELECT 2 AS second_stmt;",


  "get_db_test": "SELECT p.id, p.title, p.price, c.quantity, (c.price * c.quantity) AS cart_total FROM products p LEFT JOIN cart c ON p.title = c.product_name ORDER BY p.id ASC;",
  "get_db_test_report": "WITH product_stats AS (SELECT COUNT(*) AS product_count, COALESCE(SUM(stock), 0) AS total_stock, COALESCE(SUM(price * stock), 0) AS inventory_value, COALESCE(AVG(price), 0) AS average_price, MAX(price) AS highest_price FROM products), cart_stats AS (SELECT COUNT(*) AS cart_rows, COALESCE(SUM(c.quantity), 0) AS total_quantity, COALESCE(SUM(c.price * c.quantity), 0) AS cart_value, COUNT(DISTINCT p.id) AS matched_products FROM cart c LEFT JOIN products p ON p.title = c.product_name), user_stats AS (SELECT COUNT(*) AS user_count, COUNT(DISTINCT role) AS role_count FROM users) SELECT u.user_count, u.role_count, p.product_count, p.total_stock, p.inventory_value, p.average_price, p.highest_price, c.cart_rows, c.total_quantity, c.cart_value, c.matched_products, CASE WHEN c.total_quantity > 0 THEN c.cart_value / c.total_quantity ELSE 0 END AS average_cart_item_price FROM user_stats u CROSS JOIN product_stats p CROSS JOIN cart_stats c;",
  


  "get_cart_count": "SELECT COUNT(ci.id) AS total FROM cart_items ci JOIN carts c ON c.id = ci.cart_id WHERE c.user_id = {{user_id}} AND c.status = 'active';",
  "get_cart": "SELECT c.id AS cart_id, c.user_id, c.status, COALESCE(SUM(ci.quantity * p.price), 0) AS subtotal FROM carts c LEFT JOIN cart_items ci ON ci.cart_id = c.id LEFT JOIN products p ON p.id = ci.product_id WHERE c.user_id = {{user_id}} AND c.status = 'active' GROUP BY c.id;",
  "get_cart_items": "SELECT ci.id AS cart_item_id, ci.cart_id, ci.product_id, p.title AS name, p.price AS unit_price, ci.quantity, (p.price * ci.quantity) AS line_total, p.stock AS max_quantity, json_extract(p.images, '$[0]') AS image, SUM(p.price * ci.quantity) OVER () AS cart_total FROM cart_items ci JOIN products p ON p.id = ci.product_id JOIN carts c ON c.id = ci.cart_id WHERE c.user_id = {{user_id}} AND c.status = 'active' ORDER BY ci.id;",
  "post_cart_items": "INSERT INTO carts (user_id, session_id, status) SELECT {{user_id}}, {{session_id}}, 'active' WHERE NOT EXISTS (SELECT 1 FROM carts WHERE user_id = {{user_id}} AND status = 'active'); INSERT OR REPLACE INTO cart_items (id, cart_id, product_id, quantity, created_at, updated_at) SELECT (SELECT id FROM cart_items WHERE cart_id = (SELECT id FROM carts WHERE user_id = {{user_id}} AND status = 'active' LIMIT 1) AND product_id = {{product_id}}), (SELECT id FROM carts WHERE user_id = {{user_id}} AND status = 'active' LIMIT 1), {{product_id}}, COALESCE((SELECT quantity FROM cart_items WHERE cart_id = (SELECT id FROM carts WHERE user_id = {{user_id}} AND status = 'active' LIMIT 1) AND product_id = {{product_id}}), 0) + {{quantity}}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP WHERE {{quantity}} > 0;",
  "put_cart_items": "UPDATE cart_items SET quantity = {{quantity}}, updated_at = CURRENT_TIMESTAMP WHERE id = {{id}} AND cart_id = (SELECT id FROM carts WHERE user_id = {{user_id}} AND status = 'active' LIMIT 1) AND {{quantity}} > 0;",
  "delete_cart_items": "DELETE FROM cart_items WHERE id = {{id}} AND cart_id = (SELECT id FROM carts WHERE user_id = {{user_id}} AND status = 'active' LIMIT 1);",
  "delete_cart": "DELETE FROM cart_items WHERE cart_id = (SELECT id FROM carts WHERE user_id = {{user_id}} AND status = 'active' LIMIT 1);",  
  "put_orders": "UPDATE orders SET status = COALESCE(NULLIF({{status}}, ''), status), payment_status = COALESCE(NULLIF({{payment_status}}, ''), payment_status), updated_at = CURRENT_TIMESTAMP WHERE id = {{id}}; UPDATE invoices SET status = 'issued' WHERE order_id = {{id}} AND status = 'draft';",
  "post_orders": "INSERT INTO orders (order_number, user_id, status, payment_method, payment_status, currency, subtotal, tax, shipping, discount, total, customer_name, customer_email, customer_phone, billing_address, shipping_address, notes) SELECT 'ORD-' || strftime('%Y%m%d%H%M%S','now') || '-' || {{user_id}}, {{user_id}}, 'pending', {{payment_method}}, 'unpaid', 'PKR', COALESCE((SELECT SUM(ci.quantity * p.price) FROM cart_items ci JOIN products p ON p.id = ci.product_id JOIN carts c ON c.id = ci.cart_id WHERE c.user_id = {{user_id}} AND c.status = 'active'), 0), 0, 0, 0, COALESCE((SELECT SUM(ci.quantity * p.price) FROM cart_items ci JOIN products p ON p.id = ci.product_id JOIN carts c ON c.id = ci.cart_id WHERE c.user_id = {{user_id}} AND c.status = 'active'), 0), {{customer_name}}, {{customer_email}}, {{customer_phone}}, {{billing_address}}, COALESCE(NULLIF({{shipping_address}}, ''), {{billing_address}}), {{notes}} WHERE EXISTS (SELECT 1 FROM cart_items ci JOIN carts c ON c.id = ci.cart_id WHERE c.user_id = {{user_id}} AND c.status = 'active'); INSERT INTO order_items (order_id, product_id, product_name, unit_price, quantity, line_total) SELECT (SELECT id FROM orders WHERE user_id = {{user_id}} ORDER BY id DESC LIMIT 1), ci.product_id, p.title, p.price, ci.quantity, (p.price * ci.quantity) FROM cart_items ci JOIN products p ON p.id = ci.product_id JOIN carts c ON c.id = ci.cart_id WHERE c.user_id = {{user_id}} AND c.status = 'active'; INSERT INTO invoices (invoice_number, order_id, status) SELECT 'INV-' || order_number, id, 'draft' FROM orders WHERE id = (SELECT MAX(id) FROM orders WHERE user_id = {{user_id}}) AND NOT EXISTS (SELECT 1 FROM invoices WHERE order_id = orders.id); INSERT INTO vlo_jobs (job_type, payload, status, run_at) SELECT 'send_templated_email', json_object('to', customer_email, 'template', 'order_confirmation', 'vars', json_object('customer_name', customer_name, 'order_number', order_number, 'total', total)), 'pending', CURRENT_TIMESTAMP FROM orders WHERE id = (SELECT MAX(id) FROM orders WHERE user_id = {{user_id}}); DELETE FROM cart_items WHERE cart_id = (SELECT id FROM carts WHERE user_id = {{user_id}} AND status = 'active' LIMIT 1); UPDATE carts SET status = 'converted', updated_at = CURRENT_TIMESTAMP WHERE user_id = {{user_id}} AND status = 'active'; SELECT '/shop?step=thankyou&inv=' || invoice_number AS redirect FROM invoices ORDER BY id DESC LIMIT 1;",

"get_email_rules": "SELECT *, COUNT(*) OVER () AS total, COALESCE(SUM(CASE WHEN enabled = 1 THEN 1 ELSE 0 END) OVER (), 0) AS active, COUNT(*) OVER () - COALESCE(SUM(CASE WHEN enabled = 1 THEN 1 ELSE 0 END) OVER (), 0) AS paused FROM vlo_email_rules ORDER BY id DESC;",
"post_email_rules": "INSERT INTO vlo_email_rules (event_type, template, recipient, condition_path, condition_op, condition_val, delay_minutes, dedup_minutes, enabled) VALUES ({{event_type}}, {{template}}, {{recipient}}, NULLIF({{condition_path}}, ''), NULLIF({{condition_op}}, ''), NULLIF({{condition_val}}, ''), CAST(COALESCE(NULLIF({{delay_minutes}}, ''), '0') AS INTEGER), CAST(COALESCE(NULLIF({{dedup_minutes}}, ''), '-1') AS INTEGER), 1); SELECT * FROM vlo_email_rules ORDER BY id DESC LIMIT 1;",
"put_email_rules": "UPDATE vlo_email_rules SET enabled = {{enabled}} WHERE id = {{id}}; SELECT * FROM vlo_email_rules WHERE id = {{id}};",
"delete_email_rules": "DELETE FROM vlo_email_rules WHERE id = {{id}};",

"get_invoice": "SELECT i.id AS invoice_id, i.invoice_number, i.status AS invoice_status, i.issued_at, i.due_at, i.notes AS invoice_notes, o.id AS order_id, o.order_number, o.status AS order_status, o.payment_method, o.payment_status, o.currency, o.customer_name, o.customer_email, o.customer_phone, o.billing_address, o.shipping_address, o.subtotal, o.tax, o.shipping, o.discount, o.total, o.created_at FROM invoices i JOIN orders o ON o.id = i.order_id WHERE i.invoice_number = {{invoice_number}};",
"get_invoice_items": "SELECT oi.product_name AS name, oi.unit_price, oi.quantity, oi.line_total FROM invoices i JOIN order_items oi ON oi.order_id = i.order_id WHERE i.invoice_number = {{invoice_number}} ORDER BY oi.id;",
"get_orders": "SELECT o.*, i.invoice_number FROM orders o LEFT JOIN invoices i ON i.order_id = o.id WHERE o.id = {{order_id}};",

"get_my_orders": "SELECT o.id, o.order_number, o.created_at, i.invoice_number, o.status, o.payment_status, o.total FROM orders o JOIN invoices i ON i.order_id = o.id WHERE o.user_id = {{user_id}} AND ({{q}} = '' OR o.order_number LIKE '%' || {{q}} || '%' OR o.status LIKE '%' || {{q}} || '%') ORDER BY o.created_at DESC, o.id DESC;",

"get_all_orders": "SELECT o.id, o.order_number, o.created_at, u.name AS customer_name, o.status, o.payment_status, o.total, i.invoice_number FROM orders o JOIN users u ON u.id = o.user_id LEFT JOIN invoices i ON i.order_id = o.id WHERE ({{q}} = '' OR o.order_number LIKE '%' || {{q}} || '%' OR u.name LIKE '%' || {{q}} || '%' OR o.status LIKE '%' || {{q}} || '%') ORDER BY o.created_at DESC, o.id DESC LIMIT 100;"

}
</script>

