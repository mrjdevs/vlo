  "put_cart": "UPDATE cart SET quantity = {{quantity}} WHERE id = {{id}}; SELECT * FROM cart ORDER BY id DESC;",
  "patch_cart": "UPDATE cart SET quantity = {{quantity}} WHERE id = {{id}}; SELECT * FROM cart ORDER BY id DESC;",
  "delete_cart": "DELETE FROM cart WHERE id = {{id}}; SELECT * FROM cart ORDER BY id DESC;",
  "get_cart_by_id": "SELECT * FROM cart WHERE id = {{id}};",

    "get_cart_items": "SELECT c.id as cart_id, c.quantity, p.id as product_id, p.title, p.price, (p.price * c.quantity) as subtotal, SUM(p.price * c.quantity) OVER () as cart_total, p.images FROM cart_items c JOIN products p ON c.product_id = p.id WHERE c.user_id = {{user_id}};",  
  "post_cart_items": "INSERT INTO cart_items (user_id, product_id, quantity) VALUES ({{user_id}}, {{product_id}}, {{quantity}}) ON CONFLICT(user_id, product_id) DO UPDATE SET quantity = quantity + excluded.quantity;",
  "put_cart_items": "UPDATE cart_items SET quantity = {{quantity}} WHERE id = {{id}} AND user_id = {{user_id}}",
