<script server>
{
  "get_products_chart": {"sql": "SELECT * FROM products;", "roles": ["Admin"]},
  "get_category_stats": {"sql": "SELECT category, COUNT(*) as product_count, SUM(price) as total_revenue, AVG(price) as avg_price, SUM(stock) as total_stock FROM products GROUP BY category;", "roles": ["Admin"]},
  "get_price_distribution": {"sql": "SELECT CASE WHEN price < 25 THEN 'Under $25' WHEN price < 50 THEN '$25-$50' WHEN price < 100 THEN '$50-$100' ELSE 'Over $100' END as price_range, COUNT(*) as count FROM products GROUP BY price_range;", "roles": ["Admin"]},
  "get_stock_status": {"sql": "SELECT CASE WHEN stock = 0 THEN 'Out of Stock' WHEN stock < 5 THEN 'Low Stock' ELSE 'In Stock' END as status, COUNT(*) as count FROM products GROUP BY status;", "roles": ["Admin"]},
  "get_monthly_products": {"sql": "SELECT strftime('%Y-%m', created_at) as month, COUNT(*) as count FROM products GROUP BY month ORDER BY month DESC LIMIT 12;", "roles": ["Admin"]},
  "get_dashboard_stats": {"sql": "SELECT COUNT(*) as total_products, ROUND(SUM(price), 2) as total_revenue, ROUND(AVG(price), 2) as avg_price, COUNT(DISTINCT category) as total_categories FROM products;", "roles": ["Admin"]},
  "get_products_analytics": {"sql": "SELECT category, SUM(price) as price, SUM(stock) as stock FROM products GROUP BY category;", "roles": ["Admin"]},
  "get_sales_stats": {"sql": "SELECT MAX(category) AS category, strftime('%Y-%m-%d', created_at) AS date, SUM(price) AS price FROM products GROUP BY strftime('%Y-%m-%d', created_at) ORDER BY strftime('%Y-%m-%d', created_at) ASC;", "roles": ["Admin"]}
}
</script>