<BaseLayout title="Users" auth="true" roles="Admin">
  <div class="products-list-card">
    <Card title="Users" description="All registered users.">
      <div class="products-table-wrap">
        <table class="products-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody data-source="/api/get_users">
            {for user in users}
            <tr>
              <td>#{{user.id}}</td>
              <td>{{user.name}}</td>
              <td>{{user.email}}</td>
              <td><Badge variant="success" text="{{user.role}}" /></td>
              <td>
                <div class="product-actions">
                  <button type="button" class="vlo-btn vlo-btn-secondary" v-put="/api/users/{{user.id}}" v-param="role" v-prompt="Enter new role:">Edit Role</button>
                  <button type="button" class="vlo-btn vlo-btn-danger" v-delete="/api/users/{{user.id}}" v-confirm="Delete this user?">Delete</button>
                </div>
              </td>
            </tr>
            {else}
            <tr><td colspan="5"><div class="empty-products"><h3>No Users Found</h3></div></td></tr>
            {/for}
          </tbody>
        </table>
      </div>
    </Card>

  </div>

  <!-- Pagination uses total_pages injected globally by resolve_data_sources -->
      <!-- Pass the variables explicitly so the component can see them -->
    <Pagination />
</BaseLayout>

<style>
  /* Reuse the exact same CSS from products.vlo here, or rely on global styles */
  .products-page { max-width: 1150px; margin: 0 auto; padding: 45px 24px 70px; color: #fff; }
  .products-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 25px; margin-bottom: 30px; }
  .products-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 1.5px; color: #00f5ff; margin-bottom: 7px; }
  .products-header h1 { margin: 0; font-size: 34px; line-height: 1.15; }
  .products-header p { margin: 9px 0 0; color: #888; font-size: 15px; }
  .products-list-card { margin-top: 24px; }
  .products-table-wrap { overflow-x: auto; }
  .products-table { width: 100%; border-collapse: collapse; min-width: 700px; }
  .products-table th { padding: 13px 14px; text-align: left; background: #171717; color: #777; font-size: 11px; text-transform: uppercase; letter-spacing: .7px; border-bottom: 1px solid #292929; }
  .products-table td { padding: 12px 14px; border-bottom: 1px solid #222; color: #ccc; font-size: 13px; vertical-align: middle; }
  .products-table tbody tr:hover { background: #161616; }
  .product-actions { display: flex; justify-content: center; gap: 6px; }
  .empty-products { text-align: center; padding: 55px 20px; color: #666; }
  .empty-icon { font-size: 35px; margin-bottom: 10px; }
  .empty-products h3 { margin: 0 0 7px; color: #aaa; }
  .vlo-btn { padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; transition: all .15s; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
  .vlo-btn-primary { background: #00f5ff; color: #000; }
  .vlo-btn-secondary { background: transparent; border: 1px solid #444; color: #ccc; }
  .vlo-btn-secondary:hover { border-color: #00f5ff; color: #00f5ff; }
  .vlo-btn-danger { background: transparent; border: 1px solid #444; color: #ff6666; }
  .vlo-btn-danger:hover { background: #351717; border-color: #ff6666; }
</style>