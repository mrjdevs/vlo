<BaseLayout title="Product Management">
  <div style="max-width: 1000px; margin: 40px auto; padding: 0 20px; font-family: system-ui, sans-serif; color: #fff;">
    <h1 style="color: #00f5ff; margin-bottom: 8px;">🛒 Product Management</h1>
    <p style="color: #888; margin-bottom: 25px;">Standard REST CRUD API: GET, POST, PUT, DELETE</p>

    <div id="message" style="display:none; padding:8px 15px; margin-bottom:20px; border-radius:6px;"></div>

    <div style="background:#111; border:1px solid #222; padding:20px; border-radius:8px; margin-bottom:20px;">
      <form id="add-form" style="display:grid; grid-template-columns: 2fr 3fr 1fr 1fr auto; gap:10px; align-items: center;">
        <input type="text" id="title" placeholder="Title" required style="background:#222; border:1px solid #333; color:#fff; padding:10px; border-radius:4px;">
        <input type="text" id="description" placeholder="Description" style="background:#222; border:1px solid #333; color:#fff; padding:10px; border-radius:4px;">
        <input type="number" id="price" placeholder="Price" min="0" step="0.01" required style="background:#222; border:1px solid #333; color:#fff; padding:10px; border-radius:4px;">
        <input type="number" id="stock" placeholder="Stock" min="0" value="1" required style="background:#222; border:1px solid #333; color:#fff; padding:10px; border-radius:4px;">
        <button type="submit" style="background:#00ff88; color:#000; font-weight:bold; border:none; border-radius:4px; padding:10px 16px; cursor:pointer;">+ Add Product</button>
      </form>
    </div>

    <table style="width:100%; border-collapse:collapse; background:#111; border:1px solid #222;">
      <thead>
        <tr style="background:#1a1a1a; color:#888;">
          <th style="padding:8px; text-align:left;">ID</th>
          <th style="padding:8px; text-align:left;">Title</th>
          <th style="padding:8px; text-align:left;">Description</th>
          <th style="padding:8px; text-align:left;">Price</th>
          <th style="padding:8px; text-align:center;">Stock Available</th>
          <th style="padding:8px; text-align:left;">Created At</th>
          <th style="padding:8px; text-align:center;">Actions</th>
        </tr>
      </thead>
      <tbody id="cart-rows"></tbody>
    </table>

    <div id="empty-cart" style="display:none; text-align:center; padding:40px; color:#666;">
      No products found.
    </div>
  </div>

  <script>
    const API = '/api/products';
    let loadedProducts = [];

    function showMessage(text, error = false) {
      const box = document.getElementById('message');
      box.textContent = text;
      box.style.display = 'block';
      box.style.background = error ? '#3a1111' : '#113a25';
      box.style.color = error ? '#ff7777' : '#00ff88';
      box.style.border = error ? '1px solid #662222' : '1px solid #225533';

      setTimeout(() => {
        box.style.display = 'none';
      }, 3000);
    }

    async function request(url, options = {}) {
      try {
        const response = await fetch(url, options);
        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(data.error || `Request failed (${response.status})`);
        }

        return data;
      } catch (error) {
        showMessage(error.message, true);
        throw error;
      }
    }

    async function loadProducts() {
      try {
        const response = await request(API);
        loadedProducts = response.data || [];
        renderProducts(loadedProducts);
      } catch (error) {
        loadedProducts = [];
        renderProducts([]);
      }
    }

    function renderProducts(items) {
      const tbody = document.getElementById('cart-rows');
      const empty = document.getElementById('empty-cart');

      if (!items.length) {
        tbody.innerHTML = '';
        empty.style.display = 'block';
        return;
      }

      empty.style.display = 'none';

      tbody.innerHTML = items.map(item => {
        const title = item.title || item.product_name || item.name || 'Untitled';
        const description = item.description || '';
        const price = Number(item.price) || 0;
        const stock = item.stock ?? item.quantity ?? 0;
        const createdAt = item.created_at ? escapeHtml(item.created_at) : 'N/A';

        return `
          <tr style="border-bottom:1px solid #222;">
            <td style="padding:8px;">#${item.id}</td>
            <td style="padding:8px;">
              <strong>${escapeHtml(title)}</strong>
            </td>
            <td style="padding:8px; color:#aaa;">
              ${escapeHtml(description)}
            </td>
            <td style="padding:8px; color:#00ff88;">
              $${price.toFixed(2)}
            </td>
            <td style="padding:8px; text-align:center;">
              <button onclick="updateStock(${item.id}, ${stock - 1})"
                style="background:#333; color:#fff; border:none; padding:3px 9px; border-radius:3px; cursor:pointer;">
                −
              </button>

              <span style="display:inline-block; min-width:30px; margin:0 8px;">
                ${stock}
              </span>

              <button onclick="updateStock(${item.id}, ${stock + 1})"
                style="background:#333; color:#fff; border:none; padding:3px 9px; border-radius:3px; cursor:pointer;">
                +
              </button>
            </td>
            <td style="padding:8px; color:#888; font-size:0.85em;">
              ${createdAt}
            </td>
            <td style="padding:8px; text-align:center;">
              <button onclick="deleteItem(${item.id})"
                style="background:#ff4444; color:#fff; border:none; padding:5px 12px; border-radius:4px; cursor:pointer;">
                Delete
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    document.getElementById('add-form').addEventListener('submit', async function(e) {
      e.preventDefault();

      const title = document.getElementById('title').value.trim();
      const description = document.getElementById('description').value.trim();
      const price = parseFloat(document.getElementById('price').value);
      const stock = parseInt(document.getElementById('stock').value, 10);

      if (!title || !Number.isFinite(price) || stock < 0) {
        showMessage('Please enter valid product details.', true);
        return;
      }

      try {
        const response = await request(API, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            title: title,
            description: description,
            price: price,
            stock: stock
          })
        });

        loadedProducts = response.data || [];
        renderProducts(loadedProducts);
        this.reset();
        document.getElementById('stock').value = 1;
        showMessage('Product added successfully.');
      } catch (error) {
        // request() handles displaying errors
      }
    });

    async function updateStock(id, newStock) {
      if (newStock < 0) {
        showMessage('Stock cannot be negative.', true);
        return;
      }

      const existingItem = loadedProducts.find(p => p.id === id);
      if (!existingItem) return;

      try {
        const response = await request(API, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            id: id,
            title: existingItem.title || '',
            description: existingItem.description || '',
            price: existingItem.price || 0,
            stock: newStock
          })
        });

        loadedProducts = response.data || [];
        renderProducts(loadedProducts);
        showMessage('Stock updated.');
      } catch (error) {
        // request() handles displaying errors
      }
    }

    async function deleteItem(id) {
      if (!confirm('Remove this product?')) {
        return;
      }

      try {
        const response = await request(API, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            id: id
          })
        });

        loadedProducts = response.data || [];
        renderProducts(loadedProducts);
        showMessage('Product deleted.');
      } catch (error) {
        // request() handles displaying errors
      }
    }

    loadProducts();
  </script>
</BaseLayout>