                    <a href="#styling"><span>09</span> Styling</a>
                    <a href="#navbar"><span>10</span> Navbar</a>
                    <a href="#branding"><span>11</span> Branding</a>
                    <a href="#performance"><span>12</span> Performance</a>
                    <a href="#accessibility"><span>13</span> Accessibility</a>
                    <a href="#security"><span>14</span> Security</a>
