    letter-spacing: -.07em;
}

.final-card h2 {
    margin: 0 0 12px;

    color: #fff;

    font-size: 1.7rem;

    letter-spacing: -.03em;
}

.final-card > p {
    max-width: 570px;

    margin: 0 auto;

    color: #707070;

    font-size: .8rem;

    line-height: 1.7;
}

.final-links {
    display: flex;
    justify-content: center;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 25px;
}

.final-links a {
    padding: 9px 14px;

    border:
        1px solid
        #333;

    border-radius: 7px;

    color: #aaa;

    text-decoration: none;

    font-size: .72rem;

    transition: .2s;
}

.final-links a:hover {
    border-color: #00f5ff;

    color: #00f5ff;
}


/* =========================================
   BACK TOP
========================================= */

.back-top {
    position: fixed;

    right: 24px;
    bottom: 24px;

    width: 42px;
    height: 42px;

    border:
        1px solid
        #333;

    border-radius: 9px;

    background: #111;

    color: #00f5ff;

    cursor: pointer;

    opacity: 0;

    pointer-events: none;

    transition: .25s;
}

.back-top.visible {
    opacity: 1;

    pointer-events: auto;
}


/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 900px) {

    .docs-layout {
        grid-template-columns: 1fr;

        gap: 30px;
    }

    .docs-sidebar {
        position: static;
    }

    .docs-nav {
        display: grid;

        grid-template-columns:
            repeat(3,1fr);
    }

    .sidebar-card {
        display: none;
    }

    .brand-grid {
        grid-template-columns:
            repeat(2,1fr);
    }

}


@media (max-width: 650px) {

    .guidelines-hero {
        padding:
            55px 18px
            45px;
    }

    .guidelines-hero h1 {
        font-size: 3.2rem;
    }

    .docs-layout {
        padding:
            0 15px
            70px;
    }

    .docs-nav {
        grid-template-columns:
            repeat(2,1fr);
    }

    .principles-grid,
    .do-grid,
    .info-grid,
    .brand-rules,
    .access-grid,
    .tokens-grid {
        grid-template-columns: 1fr;
    }

    .brand-grid {
        grid-template-columns:
            repeat(2,1fr);
    }

    .architecture-flow {
        align-items: stretch;

        flex-direction: column;
    }

    .architecture-flow i {
        text-align: center;

        transform: rotate(90deg);
    }

    .naming-row {
        grid-template-columns:
            1fr 1fr 1fr;
    }

    .naming-row span {
        padding: 10px 8px;

        font-size: .62rem;
    }

}

</style>


<script>

/* =========================================
   ACTIVE DOCUMENTATION SECTION
========================================= */

const docSections =
    document.querySelectorAll(".doc-section");

const docLinks =
    document.querySelectorAll(".docs-nav a");


const docObserver =
    new IntersectionObserver(
        entries => {

            entries.forEach(entry => {

                if (!entry.isIntersecting) return;

                docLinks.forEach(link => {
                    link.classList.remove("active");
                });

                const active =
                    document.querySelector(
                        `.docs-nav a[href="#${entry.target.id}"]`
                    );

                active?.classList.add("active");

            });

        },
        {
            rootMargin:
                "-20% 0px -65% 0px"
        }
    );


docSections.forEach(section => {
    docObserver.observe(section);
});


/* =========================================
   BACK TO TOP
========================================= */

const backTop =
    document.getElementById("backTop");


window.addEventListener(
    "scroll",
    () => {

        if (window.scrollY > 500) {
            backTop.classList.add("visible");
        } else {
            backTop.classList.remove("visible");
        }

    }
);


backTop?.addEventListener(
    "click",
    () => {

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });

    }
);


/* =========================================
   SMOOTH DOCUMENT NAVIGATION
========================================= */

document
    .querySelectorAll(".docs-nav a")
    .forEach(link => {

        link.addEventListener(
            "click",
            event => {

                const target =
                    document.querySelector(
                        link.getAttribute("href")
                    );

                if (!target) return;

                event.preventDefault();

                target.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

                history.replaceState(
                    null,
                    "",
                    link.getAttribute("href")
                );

            }
        );

    });

</script>