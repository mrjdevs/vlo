    <div class="guidelines-page">
        <header class="guidelines-hero">
            <div class="hero-badge"><span class="pulse"></span> VLO PROJECT GUIDELINES</div>
            <h1>Build with <span>VLO</span>.</h1>
            <p>A practical guide for building, maintaining and extending VLO projects while keeping the codebase consistent, reusable and unmistakably VLO.</p>
            <div class="hero-meta">
                <span>✦ Architecture</span>
                <span>✦ Components</span>
                <span>✦ Templating</span>
                <span>✦ Branding</span>
                <span>✦ Performance</span>
            </div>
        </header>

        <div class="docs-layout">
            <aside class="docs-sidebar">
                <div class="sidebar-title">On this page</div>
                <nav class="docs-nav">
                    <a href="#principles" class="active"><span>01</span> Core Principles</a>
                    <a href="#structure"><span>02</span> Project Structure</a>
