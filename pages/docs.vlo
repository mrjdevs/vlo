    color: #ddd;

    font-size: .8rem;
}

.sidebar-card p {
    margin: 7px 0 0;

    color: #686868;

    font-size: .72rem;

    line-height: 1.55;
}


/* =========================================
   CONTENT
========================================= */

.docs-content {
    min-width: 0;
}

.intro-card {
    display: flex;
    gap: 18px;

    padding: 20px;

    margin-bottom: 80px;

    border:
