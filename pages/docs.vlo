    footer='<Footer />
'>
    <div class="guidelines-page">
        <header class="guidelines-hero">
            <div class="hero-badge"><span class="pulse"></span> VLO PROJECT GUIDELINES</div>
            <h1>Build with <span>VLO</span>.</h1>
            <p>A practical guide for building, maintaining and extending VLO projects while keeping the codebase consistent, reusable and unmistakably VLO.</p>
            <div class="hero-meta">
                <span>✦ Architecture</span>
                <span>✦ Components</span>
                <span>✦ Templating</span>
                <span>✦ Flash Messages</span>
                <span>✦ Pagination</span>
                <span>✦ Branding</span>
            </div>
        </header>

        <div class="docs-layout">
            <aside class="docs-sidebar">
                <div class="sidebar-title">On this page</div>
                <nav class="docs-nav">
                    <a href="#principles" class="active"><span>01</span> Core Principles</a>
                    <a href="#structure"><span>02</span> Project Structure</a>
                    <a href="#vlo-files"><span>03</span> .vlo Files</a>
                    <a href="#components"><span>04</span> Components</a>
                    <a href="#props"><span>05</span> Props</a>
                    <a href="#templating"><span>06</span> Templating</a>
                    <a href="#pages"><span>07</span> Pages</a>
                    <a href="#layouts"><span>08</span> Layouts</a>
                    <a href="#styling"><span>09</span> Styling</a>
                    <a href="#navbar"><span>10</span> Navbar</a>
                    <a href="#branding"><span>11</span> Branding</a>
                    <a href="#performance"><span>12</span> Performance</a>
                    <a href="#accessibility"><span>13</span> Accessibility</a>
                    <a href="#security"><span>14</span> Security</a>
                    <a href="#api-database"><span>15</span> API & Database</a>
                    <a href="#flash"><span>16</span> Flash Messages</a>
                    <a href="#pagination"><span>17</span> Pagination</a>
