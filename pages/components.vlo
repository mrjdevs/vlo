<BaseLayout 
    title="Components"
    navbar='
        <Navbar brand="VLO">
            <a href="/">Home</a>
            <a href="/components" class="active">Components</a>
            <a href="/pricing">Pricing</a>
            <a href="/about">About</a>
            <a href="/docs">Docs</a>
        </Navbar>'
    footer='<Footer />'
>
    <div class="components-page">

        <!-- HERO -->
        <header class="components-hero">
            <div class="hero-badge">
                <span class="pulse"></span>
                VLO UI Library
            </div>

            <h1>Components</h1>

            <p>
                Beautiful, reusable <code>.vlo</code> components for building
                modern applications faster.
            </p>

            <div class="hero-meta">
                <span>✦ 6 Components</span>
                <span>✦ Reusable</span>
                <span>✦ Props Based</span>
            </div>
        </header>

        <div class="docs-layout">

            <!-- SIDEBAR -->
            <aside class="docs-sidebar">
                <div class="sidebar-title">Components</div>

                <nav class="component-nav">
                    <a href="#button" class="nav-item active">
                        <span class="nav-icon">●</span>
                        Button
                    </a>

                    <a href="#badge" class="nav-item">
                        <span class="nav-icon">◆</span>
                        Badge
                    </a>

                    <a href="#alert" class="nav-item">
                        <span class="nav-icon">!</span>
                        Alert
                    </a>

                    <a href="#card" class="nav-item">
                        <span class="nav-icon">□</span>
                        Card
                    </a>

                    <a href="#input" class="nav-item">
                        <span class="nav-icon">⌨</span>
                        Input
                    </a>

                    <a href="#toast" class="nav-item">
                        <span class="nav-icon">◈</span>
                        Toast
                    </a>
                </nav>

                <div class="sidebar-tip">
                    <div class="tip-icon">💡</div>
                    <strong>Tip</strong>
                    <p>
                        Components accept props, so you can customize
                        them without changing the component itself.
                    </p>
                </div>
            </aside>

            <!-- CONTENT -->
            <main class="docs-content">

                <!-- SEARCH -->
                <div class="component-search">
                    <span>⌕</span>
                    <input
                        id="componentSearch"
                        type="text"
                        placeholder="Search components..."
                    />
                    <kbd>/</kbd>
                </div>

                <!-- BUTTON -->
                <section class="component-section" id="button">
                    <div class="section-heading">
                        <div>
                            <span class="component-number">01</span>
                            <h2>Button</h2>
                            <p>
                                Use VLO buttons for actions, forms,
                                navigation and dialogs.
                            </p>
                        </div>

                        <span class="status-badge">Stable</span>
                    </div>

                    <div class="demo-card">
                        <div class="demo-header">
                            <span>Preview</span>
                            <span class="demo-label">Live</span>
                        </div>

                        <div class="demo-box">
                            <Button text="Primary" href="#" variant="primary" />
                            <Button text="Secondary" href="#" variant="secondary" />
                            <Button text="Ghost" href="#" variant="ghost" />
                        </div>
                    </div>

                    <div class="usage-card">
                        <div class="usage-header">
                            <span>Usage</span>
                            <button onclick="copyCode(this, 'button-code')">
                                Copy
                            </button>
                        </div>

                        <pre id="button-code"><code>&lt;Button
    text="Primary"
    href="#"
    variant="primary"
/&gt;</code></pre>
                    </div>

                    <h3>Props</h3>

                    <div class="table-wrapper">
                        <table class="props-table">
                            <thead>
                                <tr>
                                    <th>Prop</th>
                                    <th>Type</th>
                                    <th>Default</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>text</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Button label text</td>
                                </tr>
                                <tr>
                                    <td>href</td>
                                    <td>string</td>
                                    <td>#</td>
                                    <td>Link destination</td>
                                </tr>
                                <tr>
                                    <td>variant</td>
                                    <td>primary | secondary | ghost</td>
                                    <td>primary</td>
                                    <td>Visual style</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>


                <!-- BADGE -->
                <section class="component-section" id="badge">

                    <div class="section-heading">
                        <div>
                            <span class="component-number">02</span>
                            <h2>Badge</h2>
                            <p>
                                Small labels for statuses, categories
                                and counts.
                            </p>
                        </div>

                        <span class="status-badge">Stable</span>
                    </div>

                    <div class="demo-card">
                        <div class="demo-header">
                            <span>Preview</span>
                            <span class="demo-label">Live</span>
                        </div>

                        <div class="demo-box">
                            <Badge text="Primary" variant="primary" />
                            <Badge text="Success" variant="success" />
                            <Badge text="Warning" variant="warning" />
                        </div>
                    </div>

                    <div class="usage-card">
                        <div class="usage-header">
                            <span>Usage</span>
                            <button onclick="copyCode(this, 'badge-code')">
                                Copy
                            </button>
                        </div>

                        <pre id="badge-code"><code>&lt;Badge
    text="Success"
    variant="success"
/&gt;</code></pre>
                    </div>

                    <h3>Props</h3>

                    <div class="table-wrapper">
                        <table class="props-table">
                            <thead>
                                <tr>
                                    <th>Prop</th>
                                    <th>Type</th>
                                    <th>Default</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>text</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Badge content</td>
                                </tr>
                                <tr>
                                    <td>variant</td>
                                    <td>primary | success | warning</td>
                                    <td>primary</td>
                                    <td>Color variant</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>


                <!-- ALERT -->
                <section class="component-section" id="alert">

                    <div class="section-heading">
                        <div>
                            <span class="component-number">03</span>
                            <h2>Alert</h2>
                            <p>
                                Contextual feedback for important
                                information and actions.
                            </p>
                        </div>

                        <span class="status-badge">Stable</span>
                    </div>

                    <div class="demo-card">
                        <div class="demo-header">
                            <span>Preview</span>
                            <span class="demo-label">Live</span>
                        </div>

                        <div class="demo-box col">
                            <Alert
                                title="Info"
                                description="This is an info alert"
                                variant="info"
                            />

                            <Alert
                                title="Success"
                                description="Your changes were saved"
                                variant="success"
                            />
                        </div>
                    </div>

                    <div class="usage-card">
                        <div class="usage-header">
                            <span>Usage</span>
                            <button onclick="copyCode(this, 'alert-code')">
                                Copy
                            </button>
                        </div>

                        <pre id="alert-code"><code>&lt;Alert
    title="Success"
    description="Your changes were saved"
    variant="success"
/&gt;</code></pre>
                    </div>

                    <h3>Props</h3>

                    <div class="table-wrapper">
                        <table class="props-table">
                            <thead>
                                <tr>
                                    <th>Prop</th>
                                    <th>Type</th>
                                    <th>Default</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>title</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Alert heading</td>
                                </tr>
                                <tr>
                                    <td>description</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Alert body text</td>
                                </tr>
                                <tr>
                                    <td>variant</td>
                                    <td>info | success</td>
                                    <td>info</td>
                                    <td>Alert style</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>


                <!-- CARD -->
                <section class="component-section" id="card">

                    <div class="section-heading">
                        <div>
                            <span class="component-number">04</span>
                            <h2>Card</h2>
                            <p>
                                Flexible containers for grouped content,
                                actions and information.
                            </p>
                        </div>

                        <span class="status-badge">Stable</span>
                    </div>

                    <div class="demo-card">
                        <div class="demo-header">
                            <span>Preview</span>
                            <span class="demo-label">Live</span>
                        </div>

                        <div class="demo-box grid-3">

                            <Card
                                title="With Button"
                                description="Cards support children"
                            >
                                <Button
                                    text="Action"
                                    href="#"
                                    variant="primary"
                                />
                            </Card>

                            <Card
                                title="With Badge"
                                description="Mix components inside"
                            >
                                <Badge
                                    text="New"
                                    variant="success"
                                />
                            </Card>

                            <Card
                                title="Simple"
                                description="Just title and description"
                            />

                        </div>
                    </div>

                    <div class="usage-card">
                        <div class="usage-header">
                            <span>Usage</span>
                            <button onclick="copyCode(this, 'card-code')">
                                Copy
                            </button>
                        </div>

                        <pre id="card-code"><code>&lt;Card
    title="My Card"
    description="Card description"
&gt;
    &lt;Button
        text="Action"
        href="#"
        variant="primary"
    /&gt;
&lt;/Card&gt;</code></pre>
                    </div>

                    <h3>Props</h3>

                    <div class="table-wrapper">
                        <table class="props-table">
                            <thead>
                                <tr>
                                    <th>Prop</th>
                                    <th>Type</th>
                                    <th>Default</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>title</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Card heading</td>
                                </tr>
                                <tr>
                                    <td>description</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Card body text</td>
                                </tr>
                                <tr>
                                    <td>children</td>
                                    <td>html</td>
                                    <td>—</td>
                                    <td>Content inside the card</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>


                <!-- INPUT -->
                <section class="component-section" id="input">

                    <div class="section-heading">
                        <div>
                            <span class="component-number">05</span>
                            <h2>Input</h2>
                            <p>
                                Basic form control for text, email
                                and other values.
                            </p>
                        </div>

                        <span class="status-badge">Stable</span>
                    </div>

                    <div class="demo-card">
                        <div class="demo-header">
                            <span>Preview</span>
                            <span class="demo-label">Live</span>
                        </div>

                        <div class="demo-box col">
                            <Input
                                type="text"
                                placeholder="Your name"
                            />

                            <Input
                                type="email"
                                placeholder="you@email.com"
                            />
                        </div>
                    </div>

                    <div class="usage-card">
                        <div class="usage-header">
                            <span>Usage</span>
                            <button onclick="copyCode(this, 'input-code')">
                                Copy
                            </button>
                        </div>

                        <pre id="input-code"><code>&lt;Input
    type="email"
    placeholder="you@email.com"
/&gt;</code></pre>
                    </div>

                    <h3>Props</h3>

                    <div class="table-wrapper">
                        <table class="props-table">
                            <thead>
                                <tr>
                                    <th>Prop</th>
                                    <th>Type</th>
                                    <th>Default</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>type</td>
                                    <td>string</td>
                                    <td>text</td>
                                    <td>Input type</td>
                                </tr>
                                <tr>
                                    <td>placeholder</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Placeholder text</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>


                <!-- TOAST -->
                <section class="component-section" id="toast">

                    <div class="section-heading">
                        <div>
                            <span class="component-number">06</span>
                            <h2>Toast</h2>
                            <p>
                                Lightweight notifications for success,
                                errors and other feedback.
                            </p>
                        </div>

                        <span class="status-badge">Stable</span>
                    </div>

                    <div class="demo-card">
                        <div class="demo-header">
                            <span>Preview</span>
                            <span class="demo-label">Static</span>
                        </div>

                        <div class="demo-box toast-demo">
                            <Toast
                                title="Success"
                                description="Saved!"
                                icon="✅"
                                variant="success"
                                class="static-toast"
                            />

                            <Toast
                                title="Error"
                                description="Failed"
                                icon="❌"
                                variant="error"
                                class="static-toast"
                            />
                        </div>
                    </div>

                    <div class="usage-card">
                        <div class="usage-header">
                            <span>Usage</span>
                            <button onclick="copyCode(this, 'toast-code')">
                                Copy
                            </button>
                        </div>

                        <pre id="toast-code"><code>&lt;Toast
    title="Success"
    description="Saved!"
    icon="✅"
    variant="success"
/&gt;</code></pre>
                    </div>

                    <h3>Props</h3>

                    <div class="table-wrapper">
                        <table class="props-table">
                            <thead>
                                <tr>
                                    <th>Prop</th>
                                    <th>Type</th>
                                    <th>Default</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>title</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Toast heading</td>
                                </tr>
                                <tr>
                                    <td>description</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Toast message</td>
                                </tr>
                                <tr>
                                    <td>icon</td>
                                    <td>string</td>
                                    <td>—</td>
                                    <td>Emoji or icon</td>
                                </tr>
                                <tr>
                                    <td>variant</td>
                                    <td>success | error</td>
                                    <td>success</td>
                                    <td>Toast color variant</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- END -->
                <div class="docs-end">
                    <div class="end-icon">✦</div>
                    <h2>That's all for now.</h2>
                    <p>
                        More VLO components are coming soon.
                    </p>

                    <a href="/docs" class="docs-button">
                        Read Documentation →
                    </a>
                </div>

            </main>
        </div>
    </div>

    <!-- BACK TO TOP -->
    <button id="backTop" class="back-top">↑</button>

</BaseLayout>


<style>

/* =========================
   PAGE
========================= */

.components-page {
    min-height: 100vh;
    background:
        radial-gradient(
            circle at 50% -20%,
            rgba(0, 245, 255, 0.08),
            transparent 35%
        );
}


/* =========================
   HERO
========================= */

.components-hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 80px 24px 55px;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 13px;
    border: 1px solid rgba(0, 245, 255, 0.25);
    background: rgba(0, 245, 255, 0.06);
    color: var(--primary, #00f5ff);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 22px;
}

.pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00f5ff;
    box-shadow: 0 0 12px #00f5ff;
}

.components-hero h1 {
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 1;
    margin: 0 0 20px;
    letter-spacing: -0.06em;
    background: linear-gradient(
        135deg,
        #fff,
        #00f5ff
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.components-hero p {
    max-width: 680px;
    color: #9b9b9b;
    font-size: 1.2rem;
    line-height: 1.7;
    margin: 0;
}

.components-hero code {
    color: #00f5ff;
}

.hero-meta {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    margin-top: 28px;
    color: #777;
    font-size: 0.85rem;
}


/* =========================
   LAYOUT
========================= */

.docs-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px 100px;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 60px;
}

.docs-sidebar {
    position: sticky;
    top: 90px;
    height: max-content;
}

.sidebar-title {
    color: #fff;
    font-weight: 700;
    margin-bottom: 15px;
}

.component-nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 9px 12px;
    border-radius: 8px;
    color: #888;
    text-decoration: none;
    font-size: 0.9rem;
    transition: 0.2s ease;
}

.nav-item:hover {
    color: #fff;
    background: rgba(255,255,255,0.04);
}

.nav-item.active {
    color: #00f5ff;
    background: rgba(0,245,255,0.07);
}

.nav-icon {
    width: 20px;
    text-align: center;
    color: #555;
}

.nav-item.active .nav-icon {
    color: #00f5ff;
}

.sidebar-tip {
    margin-top: 35px;
    padding: 17px;
    border: 1px solid var(--border, #292929);
    border-radius: 12px;
    background: rgba(255,255,255,0.02);
}

.tip-icon {
    margin-bottom: 8px;
}

.sidebar-tip strong {
    font-size: 0.85rem;
}

.sidebar-tip p {
    color: #777;
    font-size: 0.78rem;
    line-height: 1.55;
    margin: 7px 0 0;
}


/* =========================
   SEARCH
========================= */

.component-search {
    height: 46px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 13px;
    margin-bottom: 60px;
    border: 1px solid var(--border, #333);
    background: rgba(255,255,255,0.025);
    border-radius: 10px;
    color: #777;
}

.component-search input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: #fff;
    font-size: 0.9rem;
}

.component-search kbd {
    padding: 3px 7px;
    border: 1px solid #333;
    border-radius: 5px;
    color: #777;
    font-size: 0.7rem;
}


/* =========================
   SECTIONS
========================= */

.component-section {
    scroll-margin-top: 90px;
    margin-bottom: 110px;
}

.section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
}

.component-number {
    display: block;
    color: #00f5ff;
    font-family: monospace;
    font-size: 0.75rem;
    margin-bottom: 8px;
}

.section-heading h2 {
    margin: 0 0 8px;
    font-size: 2rem;
    letter-spacing: -0.03em;
}

.section-heading p {
    margin: 0;
    color: #888;
    line-height: 1.6;
}

.status-badge {
    flex-shrink: 0;
    border: 1px solid rgba(0,255,136,0.2);
    background: rgba(0,255,136,0.06);
    color: #00ff88;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 0.7rem;
}


/* =========================
   DEMO
========================= */

.demo-card,
.usage-card {
    border: 1px solid var(--border, #303030);
    border-radius: 13px;
    overflow: hidden;
    background: rgba(255,255,255,0.018);
}

.demo-card {
    margin-top: 25px;
}

.demo-header,
.usage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 16px;
    border-bottom: 1px solid var(--border, #303030);
    color: #888;
    font-size: 0.75rem;
    font-weight: 600;
}

.demo-label {
    color: #00ff88;
}

.demo-box {
    padding: 35px;
    display: flex;
    gap: 13px;
    flex-wrap: wrap;
    align-items: center;
}

.demo-box.col {
    flex-direction: column;
    align-items: stretch;
}

.demo-box.grid-3 {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(210px, 1fr)
    );
    align-items: stretch;
}

.toast-demo {
    min-height: 150px;
    align-items: flex-start;
}


/* =========================
   USAGE
========================= */

.usage-card {
    margin-top: 20px;
}

.usage-header button {
    border: 1px solid #333;
    background: #181818;
    color: #aaa;
    padding: 5px 10px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.7rem;
}

.usage-header button:hover {
    color: #fff;
    border-color: #555;
}

.usage-card pre {
    margin: 0;
    padding: 20px;
    overflow-x: auto;
    background: #0a0a0a;
}

.usage-card code {
    color: #b9f8ff;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.82rem;
    line-height: 1.7;
}


/* =========================
   TABLE
========================= */

.component-section h3 {
    margin: 32px 0 13px;
    font-size: 1rem;
    color: #ccc;
}

.table-wrapper {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border, #303030);
    border-radius: 10px;
}

.props-table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 0.82rem;
}

.props-table th,
.props-table td {
    padding: 13px 15px;
    text-align: left;
    border-bottom: 1px solid var(--border, #292929);
}

.props-table tr:last-child td {
    border-bottom: 0;
}

.props-table th {
    color: #777;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    background: rgba(255,255,255,0.02);
}

.props-table td:first-child {
    color: #00ff88;
    font-family: monospace;
}

.props-table td:nth-child(2) {
    color: #00f5ff;
    font-family: monospace;
}

.props-table td:nth-child(3) {
    color: #aaa;
}


/* =========================
   END
========================= */

.docs-end {
    text-align: center;
    padding: 70px 20px;
    border-top: 1px solid var(--border, #303030);
}

.end-icon {
    color: #00f5ff;
    font-size: 1.8rem;
    margin-bottom: 15px;
}

.docs-end h2 {
    margin: 0 0 10px;
}

.docs-end p {
    color: #777;
    margin-bottom: 25px;
}

.docs-button {
    display: inline-flex;
    padding: 10px 17px;
    border-radius: 8px;
    background: #00f5ff;
    color: #000;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
}


/* =========================
   BACK TOP
========================= */

.back-top {
    position: fixed;
    right: 25px;
    bottom: 25px;
    width: 42px;
    height: 42px;
    border: 1px solid #333;
    border-radius: 10px;
    background: #111;
    color: #00f5ff;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: 0.25s ease;
}

.back-top.visible {
    opacity: 1;
    pointer-events: auto;
}


/* =========================
   STATIC TOAST
========================= */

.static-toast {
    position: static !important;
    animation: none !important;
    min-width: auto !important;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 850px) {

    .docs-layout {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .docs-sidebar {
        position: static;
    }

    .component-nav {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
    }

    .sidebar-tip {
        display: none;
    }

    .component-search {
        margin-bottom: 40px;
    }
}


@media (max-width: 600px) {

    .components-hero {
        padding-top: 50px;
    }

    .components-hero h1 {
        font-size: 3rem;
    }

    .components-hero p {
        font-size: 1rem;
    }

    .docs-layout {
        padding-left: 15px;
        padding-right: 15px;
    }

    .component-nav {
        grid-template-columns: repeat(2, 1fr);
    }

    .section-heading {
        flex-direction: column;
    }

    .demo-box {
        padding: 20px;
    }

    .hero-meta {
        flex-direction: column;
        gap: 8px;
    }
}

</style>


<script>

const searchInput = document.getElementById("componentSearch");
const sections = document.querySelectorAll(".component-section");
const navItems = document.querySelectorAll(".nav-item");
const backTop = document.getElementById("backTop");


/* =========================
   COMPONENT SEARCH
========================= */

searchInput?.addEventListener("input", function () {

    const query = this.value.toLowerCase().trim();

    sections.forEach(section => {

        const text = section.innerText.toLowerCase();

        section.style.display =
            !query || text.includes(query)
                ? ""
                : "none";
    });
});


/* =========================
   "/" SEARCH SHORTCUT
========================= */

document.addEventListener("keydown", function (event) {

    if (
        event.key === "/" &&
        document.activeElement !== searchInput
    ) {
        event.preventDefault();
        searchInput?.focus();
    }

    if (
        event.key === "Escape" &&
        document.activeElement === searchInput
    ) {
        searchInput.blur();
    }
});


/* =========================
   ACTIVE SIDEBAR
========================= */

const observer = new IntersectionObserver(
    entries => {

        entries.forEach(entry => {

            if (entry.isIntersecting) {

                navItems.forEach(item => {
                    item.classList.remove("active");
                });

                const active =
                    document.querySelector(
                        `.nav-item[href="#${entry.target.id}"]`
                    );

                active?.classList.add("active");
            }
        });

    },
    {
        rootMargin: "-20% 0px -65% 0px"
    }
);

sections.forEach(section => observer.observe(section));


/* =========================
   COPY CODE
========================= */

function copyCode(button, id) {

    const code =
        document.querySelector(`#${id} code`)?.innerText;

    if (!code) return;

    navigator.clipboard.writeText(code).then(() => {

        const original = button.innerText;

        button.innerText = "Copied!";

        setTimeout(() => {
            button.innerText = original;
        }, 1400);

    });

}


/* =========================
   BACK TO TOP
========================= */

window.addEventListener("scroll", function () {

    if (window.scrollY > 500) {
        backTop.classList.add("visible");
    } else {
        backTop.classList.remove("visible");
    }

});

backTop?.addEventListener("click", function () {

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

});

</script>