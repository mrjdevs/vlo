<BaseLayout title="Your Shop" auth="true">
<div class="cart-page">

  <header class="cart-header">
    <div>
      <span class="cart-eyebrow">YOUR SHOPPING</span>
      <h1>
        {if step == "checkout"} Checkout
        {else if step == "invoice"} Invoice Details
        {else} Shopping Cart {/if}
      </h1>
      <p>Review your items, complete checkout, and manage your order.</p>
    </div>
    <a href="/products" class="cart-continue no-ajax">Continue Shopping</a>
  </header>

  <!-- =====================================================
       CART & CHECKOUT VIEWS
       ===================================================== -->
  {if step == "" || step == null || step == "checkout"}
    <div data-source="/api/cart_items">
      
      <!-- CART VIEW -->
      {if step == "" || step == null}
        <div id="cart-wrapper">
          {{ "" | ajax:",0,#cart-wrapper,html" }}
          
          <div class="cart-layout">
            <section class="cart-panel">
              <div class="cart-panel-heading">
                <h2>Your Items</h2>
                <span>{{ cart_items | count }} items</span>
              </div>

              {if cart_items}
                <div class="cart-items">
                  {for item in cart_items}
                    <article class="cart-item">
                      <div class="cart-product">
                        <div class="cart-product-image">
                          {if item.image}
                            <img src="/storage/uploads/{{item.image}}" alt="{{item.name}}">
                          {else}
                            <span>{{item.name}}</span>
                          {/if}
                        </div>
                        <div class="cart-product-info">
                          <h3>{{item.name}}</h3>
                          <span>Product #{{item.product_id}}</span>
                          <strong>PKR {{item.unit_price|double:2}}</strong>
                        </div>
                      </div>

                      <form v-put="/api/cart_items/{{item.cart_item_id}}" class="cart-item-actions" alert="false">
                        <label for="qty-{{item.cart_item_id}}">Quantity</label>
                        <input id="qty-{{item.cart_item_id}}" type="number" name="quantity"
                               min="1" max="{{item.max_quantity}}" value="{{item.quantity}}"
                               onchange="this.form.submit()" required>
                      </form>

                      <div class="cart-line-total">
                        <span>Line total</span>
                        <strong>PKR {{item.line_total|double:2}}</strong>
                        <button v-delete="/api/cart_items/{{item.cart_item_id}}" v-confirm="Remove this item?" class="cart-remove">Remove</button>
                      </div>
                    </article>
                  {/for}
                </div>

                <form class="cart-clear-form">
                  <button v-delete="/api/cart" v-confirm="Clear entire cart?" class="cart-clear">Clear Cart</button>
                </form>
              {else}
                <div class="cart-empty">
                  <span class="cart-empty-icon">🛒</span>
                  <h3>Your cart is empty</h3>
                  <p>Explore the store and add products to get started.</p>
                  <a href="/products" class="cart-primary no-ajax">Browse Products</a>
                </div>
              {/if}
            </section>

            <aside class="cart-summary">
              <h2>Order Summary</h2>
              <div class="cart-summary-row">
                <span>Subtotal</span>
                <strong>PKR {{ cart_items.0.cart_total | default:0 | double:2 }}</strong>
              </div>
              <div class="cart-summary-row">
                <span>Shipping</span>
                <strong>Free</strong>
              </div>
              <div class="cart-summary-total">
                <span>Total</span>
                <strong>PKR {{ cart_items.0.cart_total | default:0 | double:2 }}</strong>
              </div>

              {if cart_items}
                <a href="/shop?step=checkout" class="cart-primary cart-checkout-link">Proceed to Checkout</a>
              {/if}
              <p class="cart-secure-note">Your order total is calculated on the server.</p>
            </aside>
          </div>
        </div>
      {/if}

      <!-- CHECKOUT VIEW -->
      {if step == "checkout"}
        <div class="cart-layout">
          <section class="cart-panel">
            <h2>Customer & Delivery Details</h2>
            <form v-post="/api/orders" class="checkout-form">
              <div class="checkout-fields">
                <div class="cart-field">
                  <label for="customer_name">Full Name *</label>
                  <input id="customer_name" name="customer_name" type="text" value="{{user_name}}" required>
                </div>
                <div class="cart-field">
                  <label for="customer_email">Email Address *</label>
                  <input id="customer_email" name="customer_email" type="email" value="{{user_email}}" required>
                </div>
                <div class="cart-field">
                  <label for="customer_phone">Phone Number</label>
                  <input id="customer_phone" name="customer_phone" type="tel">
                </div>
                <div class="cart-field">
                  <label for="billing_address">Billing Address *</label>
                  <textarea id="billing_address" name="billing_address" required></textarea>
                </div>
                <div class="cart-field">
                  <label for="shipping_address">Shipping Address</label>
                  <textarea id="shipping_address" name="shipping_address" placeholder="Leave blank to use billing address"></textarea>
                </div>
                <div class="cart-field">
                  <label for="payment_method">Payment Method *</label>
                  <select id="payment_method" name="payment_method" required>
                    <option value="cod">Cash on Delivery</option>
                  </select>
                </div>
                <div class="cart-field cart-field-full">
                  <label for="notes">Order Notes</label>
                  <textarea id="notes" name="notes" placeholder="Optional delivery instructions"></textarea>
                </div>
              </div>

              <button type="submit" class="cart-primary">
                Place Order — PKR {{ cart_items.0.cart_total | default:0 | double:2 }}
              </button>
              <a href="/shop" class="cart-back no-ajax">Back to Cart</a>
            </form>
          </section>

          <aside class="cart-summary">
            <h2>Review Order</h2>
            {for item in cart_items}
              <div class="checkout-summary-item">
                <span>{{item.name}} × {{item.quantity}}</span>
                <strong>PKR {{item.line_total|double:2}}</strong>
              </div>
            {/for}
            <div class="cart-summary-total">
              <span>Grand Total</span>
              <strong>PKR {{ cart_items.0.cart_total | default:0 | double:2 }}</strong>
            </div>
          </aside>
        </div>
      {/if}

    </div>
  {/if}

  <!-- =====================================================
       INVOICE VIEW (Isolated Data-Source)
       ===================================================== -->
  {if step == "invoice"}
    
    <!-- 1. Fetch the Invoice Header -->
    <div data-source="/api/invoice?invoice_number={{invoice}}">
      {if invoice}
        <section class="invoice-panel">
          <div class="invoice-header">
            <div>
              <span class="cart-eyebrow">ORDER CONFIRMATION</span>
              <h2>Invoice {{ invoice.0.invoice_number }}</h2>
              <p>Order reference: {{ invoice.0.order_number }}</p>
            </div>
            <span class="invoice-status {if invoice.0.payment_status == 'paid'}status-paid{/if}">
              {{ invoice.0.order_status }} / {{ invoice.0.payment_status }}
            </span>
          </div>

          <!-- Inline Alert Target -->
          <div id="invoice-alert" style="margin-top: 16px;"></div>

          <div class="invoice-meta">
            <div><span>Invoice Date</span><strong>{{ invoice.0.issued_at }}</strong></div>
            <div><span>Payment Method</span><strong>{{ invoice.0.payment_method }}</strong></div>
            <div><span>Payment Status</span><strong>{{ invoice.0.payment_status | upper }}</strong></div>
          </div>

          <div class="invoice-addresses">
            <div>
              <h3>Bill To</h3>
              <p>{{ invoice.0.customer_name }}</p>
              <p>{{ invoice.0.customer_email }}</p>
              <p>{{ invoice.0.customer_phone }}</p>
              <p>{{ invoice.0.billing_address }}</p>
            </div>
            <div>
              <h3>Ship To</h3>
              <p>{{ invoice.0.shipping_address }}</p>
            </div>
          </div>
      {/if}
    </div>

    <!-- 2. Fetch the Invoice Items -->
    <div data-source="/api/invoice_items?invoice_number={{invoice}}">
      {if invoice_items}
          <div class="invoice-table-wrap">
            <table class="invoice-table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Unit Price</th>
                  <th>Quantity</th>
                  <th>Amount</th>
                </tr>
              </thead>
              <tbody>
                {for item in invoice_items}
                  <tr>
                    <td>{{ item.name }}</td>
                    <td>PKR {{ item.unit_price | double:2 }}</td>
                    <td>{{ item.quantity }}</td>
                    <td>PKR {{ item.line_total | double:2 }}</td>
                  </tr>
                {/for}
              </tbody>
            </table>
          </div>
      {/if}
    </div>

    <!-- 3. Totals & Actions (Back to Header Data) -->
    <div data-source="/api/invoice?invoice_number={{invoice}}">
      {if invoice}
          <div class="invoice-totals">
            <div><span>Subtotal</span><strong>PKR {{ invoice.0.subtotal | double:2 }}</strong></div>
            <div><span>Tax</span><strong>PKR {{ invoice.0.tax | double:2 }}</strong></div>
            <div><span>Shipping</span><strong>PKR {{ invoice.0.shipping | double:2 }}</strong></div>
            <div><span>Discount</span><strong>- PKR {{ invoice.0.discount | double:2 }}</strong></div>
            <div class="invoice-grand-total">
              <span>Total Due</span>
              <strong>PKR {{ invoice.0.total | double:2 }}</strong>
            </div>
          </div>

          {if invoice.0.invoice_notes}
            <div class="invoice-notes">
              <h3>Notes</h3>
              <p>{{ invoice.0.invoice_notes }}</p>
            </div>
          {/if}

          <div class="invoice-actions">
            <!-- MARK AS PAID -->
            {if invoice.0.payment_status != 'paid'}
              <form v-put="/api/orders/{{ invoice.0.order_id }}" alert="div:#invoice-alert" style="margin:0;">
                <input type="hidden" name="payment_status" value="paid">
                <button type="submit" class="cart-primary" style="background:#00ff88; color:#000; border-color:#00ff88;">
                  Mark as Paid ({{ invoice.0.payment_method | upper }})
                </button>
              </form>
            {/if}

            <button type="button" onclick="window.print()" class="cart-continue">Print Invoice</button>
            <a href="/products" class="cart-continue no-ajax">Continue Shopping</a>
          </div>
        </section>
      {/if}
    </div>
  {/if}

</div>

<style>

/* =========================================
   CART & CHECKOUT STYLES
========================================= */
.cart-page { max-width:1200px; margin:0 auto; padding:32px 24px; color:var(--text,#eee); }
.cart-header { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:28px; }
.cart-header h1 { margin:6px 0; font-size:2rem; }
.cart-header p,.cart-secure-note { color:#888; font-size:.9rem; }
.cart-eyebrow { color:var(--primary,#00f5ff); font-size:.72rem; font-weight:700; letter-spacing:.12em; }
.cart-layout { display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:24px; align-items:start; }
.cart-panel,.cart-summary,.invoice-panel { min-width:0; padding:24px; background:var(--surface,#111); border:1px solid var(--border,#292929); border-radius:12px; }
.cart-panel-heading { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:18px; }
.cart-panel-heading h2,.cart-summary h2,.cart-panel h2 { margin:0 0 16px; font-size:1.15rem; }
.cart-panel-heading h2 { margin:0; }
.cart-panel-heading span,.cart-product-info span,.cart-line-total span,.invoice-meta span { color:#888; font-size:.8rem; }
.cart-item { display:grid; grid-template-columns:minmax(0,1fr) auto auto; align-items:center; gap:20px; padding:20px 0; border-bottom:1px solid var(--border,#292929); }
.cart-product { display:flex; align-items:center; gap:14px; min-width:0; }
.cart-product-image { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:76px; height:76px; overflow:hidden; border-radius:8px; background:#1a1a1a; color:#888; font-size:.7rem; text-align:center; }
.cart-product-image img { width:100%; height:100%; object-fit:cover; }
.cart-product-info { display:flex; flex-direction:column; gap:7px; min-width:0; }
.cart-product-info h3 { margin:0; font-size:.95rem; overflow-wrap:anywhere; }
.cart-product-info strong,.cart-line-total strong { font-size:.88rem; }
.cart-item-actions { display:flex; flex-direction:column; gap:6px; }
.cart-item-actions label,.cart-field label { color:#aaa; font-size:.8rem; }
.cart-item-actions input { width:76px; }
.cart-page input,.cart-page select,.cart-page textarea { box-sizing:border-box; max-width:100%; padding:10px 12px; border:1px solid var(--border,#333); border-radius:7px; background:var(--background,#0b0b0b); color:var(--text,#eee); font:inherit; }
.cart-page input:focus,.cart-page select:focus,.cart-page textarea:focus { outline:2px solid var(--primary,#00f5ff); outline-offset:1px; }
.cart-line-total { display:flex; flex-direction:column; align-items:flex-end; gap:8px; white-space:nowrap; }
.cart-remove,.cart-clear,.cart-update,.cart-back { padding:6px 0; border:0; background:none; color:#aaa; font-size:.8rem; cursor:pointer; text-decoration:none; }
.cart-remove:hover,.cart-clear:hover,.cart-back:hover { color:#ff7777; }
.cart-clear-form { display:flex; justify-content:flex-end; }
.cart-summary { position:sticky; top:20px; }
.cart-summary-row,.cart-summary-total { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; padding:12px 0; border-bottom:1px solid var(--border,#292929); font-size:.88rem; }
.cart-summary-row span { color:#aaa; }
.cart-summary-total { margin-top:8px; padding:18px 0; border-bottom:0; font-size:1rem; }
.cart-summary-total strong { color:var(--primary,#00f5ff); font-size:1.2rem; }
.cart-primary,.cart-continue { display:inline-flex; align-items:center; justify-content:center; box-sizing:border-box; min-height:44px; padding:12px 16px; border:1px solid var(--primary,#00f5ff); border-radius:7px; background:var(--primary,#00f5ff); color:#050505; font-size:.88rem; font-weight:700; text-align:center; text-decoration:none; cursor:pointer; }
.cart-continue { background:transparent; color:var(--primary,#00f5ff); }
.cart-checkout-link { display:flex; width:100%; }
.cart-primary:hover { filter:brightness(.9); }
.cart-summary .cart-secure-note { margin:14px 0 0; line-height:1.5; }
.cart-empty { padding:48px 12px; text-align:center; }
.cart-empty-icon { font-size:2.5rem; }
.cart-empty h3 { margin:16px 0 8px; }
.cart-empty p { margin-bottom:24px; color:#888; font-size:.9rem; }
.invoice-status.status-paid { background: rgba(0, 255, 136, 0.1); border-color: rgba(0, 255, 136, 0.3); color: #00ff88; }

/* Checkout Styles */
.checkout-form { display:flex; flex-direction:column; gap:20px; }
.checkout-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
.cart-field { display:flex; flex-direction:column; gap:8px; min-width:0; }
.cart-field-full { grid-column:1/-1; }
.cart-field textarea { min-height:90px; resize:vertical; }
.checkout-form > .cart-primary { width:100%; }
.checkout-form .cart-back { align-self:center; }
.checkout-summary-item { display:flex; justify-content:space-between; gap:12px; padding:10px 0; border-bottom:1px solid var(--border,#292929); font-size:.8rem; }
.checkout-summary-item strong { white-space:nowrap; }

/* Invoice Styles */
.invoice-header { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding-bottom:24px; border-bottom:1px solid var(--border,#292929); }
.invoice-header h2 { margin:8px 0; font-size:1.5rem; }
.invoice-header p { color:#888; font-size:.85rem; }
.invoice-status { padding:6px 10px; border:1px solid var(--border,#333); border-radius:20px; color:var(--primary,#00f5ff); font-size:.78rem; text-transform:capitalize; }
.invoice-meta { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; padding:24px 0; border-bottom:1px solid var(--border,#292929); }
.invoice-meta div { display:flex; flex-direction:column; gap:7px; min-width:0; }
.invoice-meta strong { font-size:.85rem; overflow-wrap:anywhere; }
.invoice-addresses { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; padding:24px 0; }
.invoice-addresses h3,.invoice-notes h3 { margin:0 0 10px; font-size:.9rem; }
.invoice-addresses p,.invoice-notes p { margin:5px 0; color:#aaa; font-size:.85rem; overflow-wrap:anywhere; }
.invoice-table-wrap { width:100%; overflow-x:auto; }
.invoice-table { width:100%; border-collapse:collapse; font-size:.85rem; text-align:left; }
.invoice-table th,.invoice-table td { padding:14px 12px; border-bottom:1px solid var(--border,#292929); white-space:nowrap; }
.invoice-table th { color:#888; font-size:.75rem; font-weight:600; }
.invoice-table th:first-child,.invoice-table td:first-child { white-space:normal; }
.invoice-totals { width:min(100%,360px); margin:20px 0 0 auto; }
.invoice-totals div { display:flex; justify-content:space-between; gap:16px; padding:10px 0; font-size:.85rem; }
.invoice-totals span { color:#aaa; }
.invoice-grand-total { margin-top:8px; padding-top:18px!important; border-top:1px solid var(--border,#333); font-size:1rem!important; }
.invoice-grand-total strong { color:var(--primary,#00f5ff); font-size:1.15rem; }
.invoice-notes { margin-top:24px; padding:16px; border-radius:8px; background:var(--background,#0b0b0b); }
.invoice-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:28px; }
.invoice-status.status-paid {background: rgba(0, 255, 136, 0.1); border-color: rgba(0, 255, 136, 0.3); color: #00ff88;}
@media (max-width:900px) {
    .cart-layout { grid-template-columns:minmax(0,1fr) 280px; gap:16px; }
    .cart-item { grid-template-columns:minmax(0,1fr) auto; }
    .cart-product { grid-column:1/-1; }
    .cart-line-total { grid-column:2; grid-row:2; }
}
@media (max-width:650px) {
    .cart-page { padding:20px 14px; }
    .cart-header { align-items:flex-start; flex-direction:column; }
    .cart-header h1 { font-size:1.6rem; }
    .cart-layout { grid-template-columns:minmax(0,1fr); }
    .cart-panel,.cart-summary,.invoice-panel { padding:16px; }
    .cart-summary { position:static; }
    .cart-item { grid-template-columns:minmax(0,1fr); gap:14px; }
    .cart-product { grid-column:auto; }
    .cart-item-actions { flex-direction:row; flex-wrap:wrap; align-items:center; }
    .cart-line-total { grid-column:auto; grid-row:auto; align-items:flex-start; }
    .checkout-fields,.invoice-addresses { grid-template-columns:minmax(0,1fr); }
    .cart-field-full { grid-column:auto; }
    .invoice-meta { grid-template-columns:minmax(0,1fr); gap:14px; }
    .invoice-header { flex-direction:column; }
}
@media print {
    body { background:#fff!important; color:#111!important; }
    .cart-header,.invoice-actions,.cart-eyebrow { print-color-adjust:exact; }
    .cart-header,.invoice-actions,.cart-continue { display:none!important; }
    .cart-page { max-width:none; padding:0; color:#111; }
    .invoice-panel { padding:0; border:0; background:#fff; color:#111; }
    .invoice-addresses p,.invoice-meta span,.invoice-table th,.invoice-totals span { color:#444; }
    .invoice-table th,.invoice-table td,.invoice-header,.invoice-meta,.invoice-grand-total { border-color:#ddd; }
    .invoice-status,.invoice-grand-total strong { color:#111; }
}
</style>
</BaseLayout>