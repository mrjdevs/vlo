<BaseLayout title="Your Shop" auth="true">
<div class="cart-page">

  <!-- ══════════════════════════ TABS ══════════════════════════ -->
  <div class="shop-tabs">
    <a href="/shop?tab=customer{if step}&step={{step}}{else if inv}&step=invoice{/if}{if inv}&inv={{inv}}{/if}"
       class="shop-tab {if tab != 'admin'}active{/if}">
      Customer View
    </a>
    {if user_role == 'Admin' || user_role == 'Editor'}
      <a href="/shop?tab=admin{if inv}&inv={{inv}}{/if}"
         class="shop-tab {if tab == 'admin'}active{/if}">
        Admin Management
      </a>
    {/if}
  </div>

  <!-- ══════════════════════════ CUSTOMER VIEW ══════════════════════════ -->
  {if tab != "admin"}
    <header class="cart-header">
      <div>
        <span class="cart-eyebrow">YOUR SHOPPING</span>
        <h1>
          {if step == "checkout"} Checkout
          {else if step == "invoice"} Invoice Details
          {else if step == "thankyou"} Order Confirmed
          {else} Shopping Cart {/if}
        </h1>
        <p>Review your items, complete checkout, and manage your order.</p>
      </div>
      <a href="/products" class="cart-continue no-ajax">Continue Shopping</a>
    </header>

    <!-- ─── PAST ORDERS (with search) ─── -->
    <div data-source="/api/my_orders?q={{q}}">

      <!-- Search form -->
      <form method="GET" action="/shop" class="dropdown-search-form">
        <input type="hidden" name="tab" value="customer">
        <input
          type="search"
          name="q"
          value="{{q}}"
          placeholder="Search by order # or status..."
          autocomplete="off"
        >
        <button type="submit">Search</button>
        {if q}
          <a href="/shop?tab=customer" class="clear-search">Clear</a>
        {/if}
      </form>

      <!-- Dropdown of matching orders -->
      {if my_orders}
        <div class="history-dropdown-wrap">
          <label>📦 {if q}Matching Orders{else}My Past Orders{/if} ({{ my_orders | count }})</label>
            <select class="history-select" onchange="if(this.value) window.location.href=this.value">
              <option value="">Select a past order to view invoice &amp; status...</option>
              {for order in my_orders}
                <option value="/shop?tab=customer&step=invoice&inv={{ order.invoice_number }}"
                        {if inv == order.invoice_number}selected{/if}>
                  {{ order.created_at | date }} · {{ order.order_number }} — {{ order.status | upper }} — PKR {{ order.total | double:2 }}
                </option>
              {/for}
            </select>
        </div>
      {else}
        <div class="cart-empty" style="margin-bottom:24px">
          {if q}
            <h3>No matching orders</h3>
            <p>No orders match "<strong>{{q}}</strong>". <a href="/shop?tab=customer" style="color:#00f5ff">Clear search</a></p>
          {else}
            <h3>No past orders yet</h3>
            <p>Once you complete a checkout, your orders will appear here.</p>
          {/if}
        </div>
      {/if}
    </div>

    <!-- ─── CART VIEW ─── -->
    {if step == "" || step == null}
      <div data-source="/api/cart_items">
        <div id="cart-wrapper">
          {{ "" | ajax:",0,#cart-wrapper,html" }}
          <div class="cart-layout">
            <section class="cart-panel">
              <div class="cart-panel-heading">
                <h2>Your Current Cart</h2>
                <span>{{ cart_items | count }} items</span>
              </div>

              {if cart_items}
                <div class="cart-items">
                  {for item in cart_items}
                    <article class="cart-item">
                      <div class="cart-product">
                        <div class="cart-product-image">
                          {if item.image}
                            <img src="/storage/uploads/{{item.image}}" alt="{{item.name}}">
                          {else}
                            <span>{{item.name}}</span>
                          {/if}
                        </div>
                        <div class="cart-product-info">
                          <h3>{{item.name}}</h3>
                          <span>Product #{{item.product_id}}</span>
                          <strong>PKR {{item.unit_price|double:2}}</strong>
                        </div>
                      </div>

                      <form v-put="/api/cart_items/{{item.cart_item_id}}" class="cart-item-actions" alert="false">
                        <label for="qty-{{item.cart_item_id}}">Quantity</label>
                        <input id="qty-{{item.cart_item_id}}" type="number" name="quantity"
                               min="1" max="{{item.max_quantity}}" value="{{item.quantity}}"
                               onchange="this.form.submit()" required>
                      </form>

                      <div class="cart-line-total">
                        <span>Line total</span>
                        <strong>PKR {{item.line_total|double:2}}</strong>
                        <button v-delete="/api/cart_items/{{item.cart_item_id}}" v-confirm="Remove this item?" class="cart-remove">Remove</button>
                      </div>
                    </article>
                  {/for}
                </div>
                <form class="cart-clear-form">
                  <button v-delete="/api/cart" v-confirm="Clear entire cart?" class="cart-clear">Clear Cart</button>
                </form>
              {else}
                <div class="cart-empty">
                  <span class="cart-empty-icon">🛒</span>
                  <h3>Your cart is empty</h3>
                  <p>Explore the store to start a new order.</p>
                  <a href="/products" class="cart-primary no-ajax">Browse Products</a>
                </div>
              {/if}
            </section>

            <aside class="cart-summary">
              <h2>Order Summary</h2>
              <div class="cart-summary-row">
                <span>Subtotal</span>
                <strong>PKR {{ cart_items.0.cart_total | default:0 | double:2 }}</strong>
              </div>
              <div class="cart-summary-row">
                <span>Shipping</span>
                <strong>Free</strong>
              </div>
              <div class="cart-summary-total">
                <span>Total</span>
                <strong>PKR {{ cart_items.0.cart_total | default:0 | double:2 }}</strong>
              </div>
              {if cart_items}
                <a href="/shop?step=checkout" class="cart-primary cart-checkout-link">Proceed to Checkout</a>
              {/if}
              <p class="cart-secure-note">Your order total is calculated on the server.</p>
            </aside>
          </div>
        </div>
      </div>
    {/if}

    <!-- ─── CHECKOUT VIEW ─── -->
    {if step == "checkout"}
      <div data-source="/api/cart_items">
        <div class="cart-layout">
          <section class="cart-panel">
            <h2>Customer &amp; Delivery Details</h2>
            <form v-post="/api/orders" class="checkout-form">
              <div class="checkout-fields">
                <div class="cart-field">
                  <label>Full Name *</label>
                  <input name="customer_name" type="text" value="{{user_name}}" required>
                </div>
                <div class="cart-field">
                  <label>Email Address *</label>
                  <input name="customer_email" type="email" value="{{user_email}}" required>
                </div>
                <div class="cart-field">
                  <label>Phone Number</label>
                  <input name="customer_phone" type="tel">
                </div>
                <div class="cart-field">
                  <label>Billing Address *</label>
                  <textarea name="billing_address" required></textarea>
                </div>
                <div class="cart-field">
                  <label>Shipping Address</label>
                  <textarea name="shipping_address" placeholder="Leave blank to use billing address"></textarea>
                </div>
                <div class="cart-field">
                  <label>Payment Method *</label>
                  <select name="payment_method" required>
                    <option value="cod">Cash on Delivery</option>
                  </select>
                </div>
                <div class="cart-field cart-field-full">
                  <label>Order Notes</label>
                  <textarea name="notes" placeholder="Optional delivery instructions"></textarea>
                </div>
              </div>
              <button type="submit" class="cart-primary">
                Place Order — PKR {{ cart_items.0.cart_total | default:0 | double:2 }}
              </button>
              <a href="/shop?tab=customer" class="cart-back no-ajax">Back to Cart</a>
            </form>
          </section>

          <aside class="cart-summary">
            <h2>Review Order</h2>
            {for item in cart_items}
              <div class="checkout-summary-item">
                <span>{{item.name}} × {{item.quantity}}</span>
                <strong>PKR {{item.line_total|double:2}}</strong>
              </div>
            {/for}
            <div class="cart-summary-total">
              <span>Grand Total</span>
              <strong>PKR {{ cart_items.0.cart_total | default:0 | double:2 }}</strong>
            </div>
          </aside>
        </div>
      </div>
    {/if}

    <!-- ─── INVOICE VIEW ─── -->
    {if step == "invoice"}
      {if inv}
        <div id="invoice-wrapper">
          {{ "" | ajax:",0,#invoice-wrapper,html" }}

          <div data-source="/api/invoice?invoice_number={{inv}}">
            {if invoice}
              <section class="invoice-panel">
                <div class="invoice-header">
                  <div>
                    <span class="cart-eyebrow">ORDER CONFIRMATION</span>
                    <h2>Invoice {{ invoice.0.invoice_number }}</h2>
                    <p>Order reference: {{ invoice.0.order_number }}</p>
                  </div>
                  <span class="invoice-status {if invoice.0.payment_status == 'paid'}status-paid{/if}">
                    {{ invoice.0.order_status }} / {{ invoice.0.payment_status }}
                  </span>
                </div>
                <div id="invoice-alert" style="margin-top: 16px;"></div>
                <div class="invoice-meta">
                  <div><span>Invoice Date</span><strong>{{ invoice.0.issued_at }}</strong></div>
                  <div><span>Payment Method</span><strong>{{ invoice.0.payment_method }}</strong></div>
                  <div><span>Payment Status</span><strong>{{ invoice.0.payment_status | upper }}</strong></div>
                </div>
                <div class="invoice-addresses">
                  <div>
                    <h3>Bill To</h3>
                    <p>{{ invoice.0.customer_name }}</p>
                    <p>{{ invoice.0.customer_email }}</p>
                    <p>{{ invoice.0.customer_phone }}</p>
                    <p>{{ invoice.0.billing_address }}</p>
                  </div>
                  <div>
                    <h3>Ship To</h3>
                    <p>{{ invoice.0.shipping_address }}</p>
                  </div>
                </div>
            {/if}
          </div>

          <div data-source="/api/invoice_items?invoice_number={{inv}}">
            {if invoice_items}
              <div class="invoice-table-wrap">
                <table class="invoice-table">
                  <thead>
                    <tr><th>Product</th><th>Unit Price</th><th>Quantity</th><th>Amount</th></tr>
                  </thead>
                  <tbody>
                    {for item in invoice_items}
                      <tr>
                        <td>{{ item.name }}</td>
                        <td>PKR {{ item.unit_price | double:2 }}</td>
                        <td>{{ item.quantity }}</td>
                        <td>PKR {{ item.line_total | double:2 }}</td>
                      </tr>
                    {/for}
                  </tbody>
                </table>
              </div>
            {/if}
          </div>

          <div data-source="/api/invoice?invoice_number={{inv}}">
            {if invoice}
              <div class="invoice-totals">
                <div><span>Subtotal</span><strong>PKR {{ invoice.0.subtotal | double:2 }}</strong></div>
                <div><span>Tax</span><strong>PKR {{ invoice.0.tax | double:2 }}</strong></div>
                <div><span>Shipping</span><strong>PKR {{ invoice.0.shipping | double:2 }}</strong></div>
                <div><span>Discount</span><strong>- PKR {{ invoice.0.discount | double:2 }}</strong></div>
                <div class="invoice-grand-total">
                  <span>Total Due</span>
                  <strong>PKR {{ invoice.0.total | double:2 }}</strong>
                </div>
              </div>
              {if invoice.0.invoice_notes}
                <div class="invoice-notes">
                  <h3>Notes</h3>
                  <p>{{ invoice.0.invoice_notes }}</p>
                </div>
              {/if}
              <div class="invoice-actions">
                {if invoice.0.payment_status != 'paid'}
                  <form v-put="/api/orders/{{ invoice.0.order_id }}" alert="div:#invoice-alert" style="margin:0;">
                    <input type="hidden" name="payment_status" value="paid">
                    <button type="submit" class="cart-primary" style="background:#00ff88; color:#000; border-color:#00ff88;">
                      Mark as Paid ({{ invoice.0.payment_method | upper }})
                    </button>
                  </form>
                {/if}
                <button type="button" onclick="window.print()" class="cart-continue">Print Invoice</button>
                <a href="/shop?tab=customer" class="cart-continue no-ajax">Back to Shop</a>
              </div>
            </section>
          {/if}
        </div>
      {else}
        <div class="cart-empty" style="margin-top:20px">
          <h3>No Invoice Selected</h3>
          <p>Pick a past order from the dropdown above, or <a href="/shop?tab=customer" style="color:#00f5ff">return to the shop</a>.</p>
        </div>
      {/if}
    {/if}

    <!-- ─── THANK YOU VIEW ─── -->
    {if step == "thankyou"}
      {if inv}
        <div class="thanks-page">
          <div data-source="/api/invoice?invoice_number={{inv}}">
            {if invoice}
              <div class="thanks-hero">
                <div class="thanks-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M8 12l3 3 6-6"/>
                  </svg>
                </div>
                <span class="cart-eyebrow">ORDER CONFIRMED</span>
                <h1>Thank you, {{ invoice.0.customer_name | proper }}!</h1>
                <p class="thanks-lead">
                  Order <strong>{{ invoice.0.order_number }}</strong> is confirmed.
                  A receipt is on its way to <strong>{{ invoice.0.customer_email }}</strong>.
                </p>
              </div>
            {/if}
          </div>

          <div class="thanks-grid">
            <div class="thanks-col">
              <div data-source="/api/invoice_items?invoice_number={{inv}}">
                {if invoice_items}
                  <div class="thanks-card">
                    <div class="thanks-card-head"><span>Order Summary</span></div>
                    {for item in invoice_items}
                      <div class="thanks-item">
                        <span>{{ item.name }} × {{ item.quantity }}</span>
                        <strong>PKR {{ item.line_total | double:2 }}</strong>
                      </div>
                    {/for}
                  </div>
                {/if}
              </div>

              <div data-source="/api/invoice?invoice_number={{inv}}">
                {if invoice}
                  <div class="thanks-card">
                    <div class="thanks-total">
                      <span>Total Paid</span>
                      <strong>PKR {{ invoice.0.total | double:2 }}</strong>
                    </div>
                    <div class="thanks-ship">
                      <h4>Shipping To</h4>
                      <p>{{ invoice.0.shipping_address }}</p>
                    </div>
                  </div>
                {/if}
              </div>
            </div>

            <div class="thanks-col">
              <div data-source="/api/invoice?invoice_number={{inv}}">
                {if invoice}
                  <div class="thanks-card">
                    <div class="thanks-card-head"><span>What happens next</span></div>
                    <div class="thanks-timeline">
                      {assign status = invoice.0.order_status | default:"pending"}

                      <div class="thanks-step {if status == 'pending' || status == 'confirmed' || status == 'processing' || status == 'shipped' || status == 'completed'}active{/if} {if status != 'pending' && status != 'confirmed'}done{/if}">
                        <span class="thanks-dot"></span>
                        <div>
                          <strong>Order Placed</strong>
                          <small>{if status == 'pending'}Just now{else}Confirmed{/if}</small>
                        </div>
                      </div>

                      <div class="thanks-step {if status == 'processing' || status == 'shipped' || status == 'completed'}active{/if} {if status == 'shipped' || status == 'completed'}done{/if}">
                        <span class="thanks-dot"></span>
                        <div>
                          <strong>Processing</strong>
                          <small>{if status == 'processing'}In progress{else if status == 'shipped' || status == 'completed'}Complete{else}Within 24 hours{/if}</small>
                        </div>
                      </div>

                      <div class="thanks-step {if status == 'shipped' || status == 'completed'}active{/if} {if status == 'completed'}done{/if}">
                        <span class="thanks-dot"></span>
                        <div>
                          <strong>Shipped</strong>
                          <small>{if status == 'shipped'}In transit{else if status == 'completed'}Delivered{else}Tracking sent by email{/if}</small>
                        </div>
                      </div>

                      <div class="thanks-step {if status == 'completed'}active{/if}">
                        <span class="thanks-dot"></span>
                        <div>
                          <strong>Delivered</strong>
                          <small>{if status == 'completed'}Complete{else}Enjoy your purchase{/if}</small>
                        </div>
                      </div>
                    </div>

                    {if status == 'cancelled' || status == 'refunded'}
                      <div class="thanks-cancelled">
                        <strong>Order {if status == 'cancelled'}Cancelled{else}Refunded{/if}</strong>
                        <p>Contact support for details.</p>
                      </div>
                    {/if}

                    <div class="thanks-actions">
                      <a href="/shop?tab=customer&step=invoice&inv={{ invoice.0.invoice_number }}" class="cart-primary">View Invoice</a>
                      <a href="/products" class="cart-continue no-ajax">Continue Shopping</a>
                    </div>
                  </div>
                {/if}
              </div>
            </div>
          </div>
        </div>
      {/if}
    {/if}
  {/if}

  <!-- ══════════════════════════ ADMIN VIEW ══════════════════════════ -->
  {if tab == "admin" && (user_role == 'Admin' || user_role == 'Editor')}
    <header class="cart-header">
      <div>
        <span class="cart-eyebrow" style="color:#ffaa00">ADMIN CONTROL</span>
        <h1>Order Management</h1>
        <p>Search and select an order to update its fulfillment and payment status.</p>
      </div>
    </header>

    <!-- 🔥 SEARCH FORM + DATA-SOURCE WITH ?q= -->
    <div data-source="/api/all_orders?q={{q}}">

      <!-- Search input (always visible, even when no results) -->
      <form method="GET" action="/shop" class="dropdown-search-form">
        <input type="hidden" name="tab" value="admin">
        <input
          type="search"
          name="q"
          value="{{q}}"
          placeholder="Search by order #, customer name, or status..."
          autocomplete="off"
        >
        <button type="submit">Search</button>
        {if q}
          <a href="/shop?tab=admin" class="clear-search">Clear</a>
        {/if}
      </form>

      <!-- Results dropdown -->
      {if all_orders}
        <div class="history-dropdown-wrap" style="border-color:#ffaa00">
          <label style="color:#ffaa00">📋 Matching Orders ({{ all_orders | count }})</label>
            <select class="history-select" onchange="if(this.value) window.location.href=this.value">
              <option value="">Select an order to manage...</option>
              {for o in all_orders}
                <option value="/shop?tab=admin&inv={{ o.invoice_number }}"
                        {if inv == o.invoice_number}selected{/if}>
                  {{ o.created_at | date }} · #{{ o.order_number }} — {{ o.customer_name }} — {{ o.status | upper }} — PKR {{ o.total | double:2 }}
                </option>
              {/for}
            </select>
        </div>
      {else}
        <div class="cart-empty" style="margin-top:20px">
          {if q}
            <h3>No matching orders</h3>
            <p>No orders match "<strong>{{q}}</strong>". <a href="/shop?tab=admin" style="color:#00f5ff">Clear search</a></p>
          {else}
            <h3>No orders yet</h3>
            <p>Orders will appear here once customers complete checkouts.</p>
          {/if}
        </div>
      {/if}

    </div>

    <!-- ADMIN FORM (shows when an order is selected) -->
    {if inv}
      <div data-source="/api/invoice?invoice_number={{inv}}">
        {if invoice}
          <div class="admin-order-card" style="margin-top:20px; border-color:#00f5ff">
            <div class="admin-order-header">
              <div>
                <strong>Managing: {{ invoice.0.order_number }}</strong>
                <span>Customer: {{ invoice.0.customer_name }} ({{ invoice.0.customer_email }})</span>
              </div>
              <div class="admin-order-meta">
                <span>Total: PKR {{ invoice.0.total | double:2 }}</span>
                <span>Date: {{ invoice.0.created_at | date }}</span>
                <span>Invoice: {{ invoice.0.invoice_number }}</span>
              </div>
            </div>
            <form v-put="/api/orders/{{ invoice.0.order_id }}" class="admin-status-form" alert="false">
              <div class="admin-select-group">
                <label>Order Status</label>
                <select name="status">
                  <option value="pending"    {if invoice.0.order_status == 'pending'}selected{/if}>Pending</option>
                  <option value="confirmed"  {if invoice.0.order_status == 'confirmed'}selected{/if}>Confirmed</option>
                  <option value="processing" {if invoice.0.order_status == 'processing'}selected{/if}>Processing</option>
                  <option value="shipped"    {if invoice.0.order_status == 'shipped'}selected{/if}>Shipped</option>
                  <option value="completed"  {if invoice.0.order_status == 'completed'}selected{/if}>Completed</option>
                  <option value="cancelled"  {if invoice.0.order_status == 'cancelled'}selected{/if}>Cancelled</option>
                  <option value="refunded"   {if invoice.0.order_status == 'refunded'}selected{/if}>Refunded</option>
                </select>
              </div>
              <div class="admin-select-group">
                <label>Payment Status</label>
                <select name="payment_status">
                  <option value="unpaid"   {if invoice.0.payment_status == 'unpaid'}selected{/if}>Unpaid</option>
                  <option value="pending"  {if invoice.0.payment_status == 'pending'}selected{/if}>Pending</option>
                  <option value="paid"     {if invoice.0.payment_status == 'paid'}selected{/if}>Paid</option>
                  <option value="failed"   {if invoice.0.payment_status == 'failed'}selected{/if}>Failed</option>
                  <option value="refunded" {if invoice.0.payment_status == 'refunded'}selected{/if}>Refunded</option>
                </select>
              </div>
              <button type="submit" class="admin-btn-save">Save Changes</button>
            </form>
            <div class="admin-order-actions">
              <a href="/shop?tab=customer&step=invoice&inv={{ invoice.0.invoice_number }}" class="admin-btn-view">View Full Invoice →</a>
            </div>
          </div>
        {/if}
      </div>
    {/if}
  {/if}

</div>

<style>
/* ══════════════════════════ TABS & DROPDOWNS ══════════════════════════ */
.shop-tabs{display:flex;gap:4px;margin-bottom:24px;border-bottom:1px solid #232323;padding-bottom:0}
.shop-tab{padding:12px 24px;color:#888;text-decoration:none;font-weight:600;font-size:.9rem;border-bottom:2px solid transparent;transition:all .2s}
.shop-tab:hover{color:#ccc}
.shop-tab.active{color:#00f5ff;border-bottom-color:#00f5ff}

.history-dropdown-wrap{display:flex;flex-direction:column;gap:8px;padding:16px;background:#0f0f0f;border:1px solid #232323;border-radius:12px;margin-bottom:24px}
.history-dropdown-wrap label{font-size:.8rem;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:.05em}
.history-select{padding:12px 16px;background:#050505;border:1px solid #333;border-radius:8px;color:#fff;font-size:.95rem;outline:none;cursor:pointer;appearance:none;background-image:url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%2300f5ff%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");background-repeat:no-repeat,repeat;background-position:right .7em top 50%,0 0;background-size:.65em auto,100%}
.history-select:focus{border-color:#00f5ff;box-shadow:0 0 0 3px rgba(0,245,255,.1)}
.history-select option{background:#0f0f0f;color:#fff;padding:8px}

.dropdown-search-form{display:flex;gap:8px;margin-bottom:12px}
.dropdown-search-form input[type="search"]{flex:1;padding:12px 16px;background:#050505;border:1px solid #333;border-radius:8px;color:#fff;font-size:.95rem;outline:none}
.dropdown-search-form input[type="search"]:focus{border-color:#00f5ff;box-shadow:0 0 0 3px rgba(0,245,255,.1)}
.dropdown-search-form button{padding:12px 20px;background:#00f5ff;color:#000;border:none;border-radius:8px;font-weight:700;cursor:pointer}
.dropdown-search-form button:hover{background:#00d8e0}
.clear-search{padding:12px 16px;color:#888;text-decoration:none;font-size:.85rem;border:1px solid #333;border-radius:8px;line-height:1}
.clear-search:hover{color:#ff6666;border-color:#ff6666}
/* ══════════════════════════ ADMIN ORDERS ══════════════════════════ */
.admin-order-card{background:#0f0f0f;border:1px solid #232323;border-radius:12px;padding:24px;transition:border-color .2s}
.admin-order-header{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:20px;margin-bottom:20px;border-bottom:1px solid #1a1a1a}
.admin-order-header strong{display:block;color:#fff;font-size:1.15rem;margin-bottom:6px}
.admin-order-header span{color:#888;font-size:.9rem}
.admin-order-meta{text-align:right;display:flex;flex-direction:column;gap:6px;font-size:.9rem;color:#aaa}
.admin-status-form{display:grid;grid-template-columns:1fr 1fr auto;gap:20px;align-items:end}
.admin-select-group{display:flex;flex-direction:column;gap:8px}
.admin-select-group label{font-size:.75rem;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.05em}
.admin-select-group select{padding:12px 16px;background:#050505;border:1px solid #333;border-radius:8px;color:#fff;font-size:.95rem;outline:none;cursor:pointer}
.admin-select-group select:focus{border-color:#00f5ff}
.admin-btn-save{padding:12px 24px;background:#00f5ff;color:#000;border:none;border-radius:8px;font-weight:700;font-size:.9rem;cursor:pointer;transition:all .2s;height:46px}
.admin-btn-save:hover{background:#00d8e0}
.admin-order-actions{margin-top:24px;padding-top:20px;border-top:1px solid #1a1a1a;text-align:right}
.admin-btn-view{color:#a78bfa;text-decoration:none;font-size:.9rem;font-weight:600;transition:color .2s}
.admin-btn-view:hover{color:#c4b5fd}

/* ══════════════════════════ THANK YOU PAGE ══════════════════════════ */
.thanks-page{max-width:960px;margin:0 auto;padding:24px 0 60px}
.thanks-hero{text-align:center;padding:28px 16px 40px}
.thanks-icon{display:inline-grid;place-items:center;width:96px;height:96px;border-radius:50%;background:rgba(0,255,136,.08);border:2px solid rgba(0,255,136,.3);color:#00ff88;margin-bottom:20px;animation:thanksPop .6s cubic-bezier(.34,1.56,.64,1);box-shadow:0 0 40px rgba(0,255,136,.15)}
.thanks-icon svg{width:52px;height:52px}
@keyframes thanksPop{0%{transform:scale(0);opacity:0}60%{transform:scale(1.1)}100%{transform:scale(1);opacity:1}}
.thanks-hero h1{margin:12px 0 14px;font-size:clamp(1.8rem,4vw,2.6rem);font-weight:700;color:#fff;letter-spacing:-.03em;line-height:1.15}
.thanks-lead{max-width:580px;margin:0 auto;color:#888;font-size:1rem;line-height:1.65}
.thanks-lead strong{color:#00f5ff;font-weight:600}
.thanks-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
.thanks-col{display:flex;flex-direction:column;gap:20px}
.thanks-card{background:var(--surface,#111);border:1px solid var(--border,#232323);border-radius:12px;padding:24px}
.thanks-card-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding-bottom:16px;margin-bottom:16px;border-bottom:1px solid var(--border,#232323)}
.thanks-card-head span{font-size:.95rem;font-weight:700;color:#fff}
.thanks-item{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #1a1a1a;font-size:.88rem}
.thanks-item:last-of-type{border-bottom:0;padding-bottom:0}
.thanks-item span{color:#aaa;flex:1;line-height:1.5}
.thanks-item strong{color:#ddd;font-family:ui-monospace,monospace;font-size:.85rem;white-space:nowrap}
.thanks-total{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-bottom:20px;border-bottom:1px solid #1a1a1a}
.thanks-total span{color:#aaa;font-size:.9rem;font-weight:600}
.thanks-total strong{color:#00ff88;font-size:1.35rem;font-family:ui-monospace,monospace;font-weight:700}
.thanks-ship{margin-top:20px}
.thanks-ship h4{margin:0 0 8px;font-size:.72rem;font-weight:700;color:#666;text-transform:uppercase;letter-spacing:.06em}
.thanks-ship p{margin:0;color:#aaa;font-size:.88rem;line-height:1.6;white-space:pre-line}
.thanks-timeline{display:flex;flex-direction:column}
.thanks-step{display:flex;gap:14px;padding:12px 0;position:relative}
.thanks-step:not(:last-child)::before{content:"";position:absolute;left:9px;top:34px;bottom:-12px;width:2px;background:#232323}
.thanks-step.active:not(:last-child)::before{background:rgba(0,255,136,.4)}
.thanks-dot{width:20px;height:20px;border-radius:50%;background:#232323;border:2px solid #232323;flex-shrink:0;margin-top:2px;display:grid;place-items:center;z-index:1;transition:all .3s}
.thanks-step.active .thanks-dot{background:#00ff88;border-color:#00ff88;box-shadow:0 0 12px rgba(0,255,136,.4)}
.thanks-step.active .thanks-dot::after{content:"";width:6px;height:6px;border-radius:50%;background:#000}
.thanks-step.done .thanks-dot{background:#00ff88;border-color:#00ff88;box-shadow:none}
.thanks-step.done .thanks-dot::after{content:"✓";color:#000;font-size:11px;font-weight:700;background:none;width:auto;height:auto}
.thanks-step.done strong{color:#00ff88}
.thanks-step div{display:flex;flex-direction:column;gap:2px;padding-top:2px}
.thanks-step strong{color:#ccc;font-size:.9rem;font-weight:600}
.thanks-step.active strong{color:#fff}
.thanks-step small{color:#666;font-size:.75rem}
.thanks-actions{display:flex;flex-direction:column;gap:10px;margin-top:20px;padding-top:20px;border-top:1px solid #1a1a1a}
.thanks-actions .cart-primary,.thanks-actions .cart-continue{width:100%;box-sizing:border-box}
.thanks-cancelled{margin-top:16px;padding:14px 16px;border-radius:10px;background:rgba(255,68,68,.06);border:1px solid rgba(255,68,68,.25);color:#ff8888}
.thanks-cancelled strong{display:block;margin-bottom:6px;color:#ff6666;font-size:.95rem}
.thanks-cancelled p{margin:0;font-size:.85rem;color:#cc8888}

/* ══════════════════════════ CART & CHECKOUT ══════════════════════════ */
.cart-page{max-width:1200px;margin:0 auto;padding:32px 24px;color:var(--text,#eee)}
.cart-header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}
.cart-header h1{margin:6px 0;font-size:2rem}
.cart-header p,.cart-secure-note{color:#888;font-size:.9rem}
.cart-eyebrow{color:var(--primary,#00f5ff);font-size:.72rem;font-weight:700;letter-spacing:.12em}
.cart-layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:24px;align-items:start}
.cart-panel,.cart-summary,.invoice-panel{min-width:0;padding:24px;background:var(--surface,#111);border:1px solid var(--border,#292929);border-radius:12px}
.cart-panel-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}
.cart-panel-heading h2,.cart-summary h2,.cart-panel h2{margin:0 0 16px;font-size:1.15rem}
.cart-panel-heading h2{margin:0}
.cart-panel-heading span,.cart-product-info span,.cart-line-total span,.invoice-meta span{color:#888;font-size:.8rem}
.cart-item{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:20px;padding:20px 0;border-bottom:1px solid var(--border,#292929)}
.cart-product{display:flex;align-items:center;gap:14px;min-width:0}
.cart-product-image{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:76px;height:76px;overflow:hidden;border-radius:8px;background:#1a1a1a;color:#888;font-size:.7rem;text-align:center}
.cart-product-image img{width:100%;height:100%;object-fit:cover}
.cart-product-info{display:flex;flex-direction:column;gap:7px;min-width:0}
.cart-product-info h3{margin:0;font-size:.95rem;overflow-wrap:anywhere}
.cart-product-info strong,.cart-line-total strong{font-size:.88rem}
.cart-item-actions{display:flex;flex-direction:column;gap:6px}
.cart-item-actions label,.cart-field label{color:#aaa;font-size:.8rem}
.cart-item-actions input{width:76px}
.cart-page input,.cart-page select,.cart-page textarea{box-sizing:border-box;max-width:100%;padding:10px 12px;border:1px solid var(--border,#333);border-radius:7px;background:var(--background,#0b0b0b);color:var(--text,#eee);font:inherit}
.cart-page input:focus,.cart-page select:focus,.cart-page textarea:focus{outline:2px solid var(--primary,#00f5ff);outline-offset:1px}
.cart-line-total{display:flex;flex-direction:column;align-items:flex-end;gap:8px;white-space:nowrap}
.cart-remove,.cart-clear,.cart-update,.cart-back{padding:6px 0;border:0;background:none;color:#aaa;font-size:.8rem;cursor:pointer;text-decoration:none}
.cart-remove:hover,.cart-clear:hover,.cart-back:hover{color:#ff7777}
.cart-clear-form{display:flex;justify-content:flex-end}
.cart-summary{position:sticky;top:20px}
.cart-summary-row,.cart-summary-total{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border,#292929);font-size:.88rem}
.cart-summary-row span{color:#aaa}
.cart-summary-total{margin-top:8px;padding:18px 0;border-bottom:0;font-size:1rem}
.cart-summary-total strong{color:var(--primary,#00f5ff);font-size:1.2rem}
.cart-primary,.cart-continue{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-height:44px;padding:12px 16px;border:1px solid var(--primary,#00f5ff);border-radius:7px;background:var(--primary,#00f5ff);color:#050505;font-size:.88rem;font-weight:700;text-align:center;text-decoration:none;cursor:pointer}
.cart-continue{background:transparent;color:var(--primary,#00f5ff)}
.cart-checkout-link{display:flex;width:100%}
.cart-primary:hover{filter:brightness(.9)}
.cart-summary .cart-secure-note{margin:14px 0 0;line-height:1.5}
.cart-empty{padding:48px 12px;text-align:center}
.cart-empty-icon{font-size:2.5rem}
.cart-empty h3{margin:16px 0 8px}
.cart-empty p{margin-bottom:24px;color:#888;font-size:.9rem}
.invoice-status.status-paid{background:rgba(0,255,136,0.1);border-color:rgba(0,255,136,0.3);color:#00ff88}

/* ══════════════════════════ CHECKOUT STYLES ══════════════════════════ */
.checkout-form{display:flex;flex-direction:column;gap:20px}
.checkout-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.cart-field{display:flex;flex-direction:column;gap:8px;min-width:0}
.cart-field-full{grid-column:1/-1}
.cart-field textarea{min-height:90px;resize:vertical}
.checkout-form > .cart-primary{width:100%}
.checkout-form .cart-back{align-self:center}
.checkout-summary-item{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--border,#292929);font-size:.8rem}
.checkout-summary-item strong{white-space:nowrap}

/* ══════════════════════════ INVOICE STYLES ══════════════════════════ */
.invoice-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding-bottom:24px;border-bottom:1px solid var(--border,#292929)}
.invoice-header h2{margin:8px 0;font-size:1.5rem}
.invoice-header p{color:#888;font-size:.85rem}
.invoice-status{padding:6px 10px;border:1px solid var(--border,#333);border-radius:20px;color:var(--primary,#00f5ff);font-size:.78rem;text-transform:capitalize}
.invoice-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;padding:24px 0;border-bottom:1px solid var(--border,#292929)}
.invoice-meta div{display:flex;flex-direction:column;gap:7px;min-width:0}
.invoice-meta strong{font-size:.85rem;overflow-wrap:anywhere}
.invoice-addresses{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;padding:24px 0}
.invoice-addresses h3,.invoice-notes h3{margin:0 0 10px;font-size:.9rem}
.invoice-addresses p,.invoice-notes p{margin:5px 0;color:#aaa;font-size:.85rem;overflow-wrap:anywhere}
.invoice-table-wrap{width:100%;overflow-x:auto}
.invoice-table{width:100%;border-collapse:collapse;font-size:.85rem;text-align:left}
.invoice-table th,.invoice-table td{padding:14px 12px;border-bottom:1px solid var(--border,#292929);white-space:nowrap}
.invoice-table th{color:#888;font-size:.75rem;font-weight:600}
.invoice-table th:first-child,.invoice-table td:first-child{white-space:normal}
.invoice-totals{width:min(100%,360px);margin:20px 0 0 auto}
.invoice-totals div{display:flex;justify-content:space-between;gap:16px;padding:10px 0;font-size:.85rem}
.invoice-totals span{color:#aaa}
.invoice-grand-total{margin-top:8px;padding-top:18px!important;border-top:1px solid var(--border,#333);font-size:1rem!important}
.invoice-grand-total strong{color:var(--primary,#00f5ff);font-size:1.15rem}
.invoice-notes{margin-top:24px;padding:16px;border-radius:8px;background:var(--background,#0b0b0b)}
.invoice-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}

/* ══════════════════════════ RESPONSIVE & PRINT ══════════════════════════ */
@media (max-width:900px){
  .cart-layout{grid-template-columns:minmax(0,1fr) 280px;gap:16px}
  .cart-item{grid-template-columns:minmax(0,1fr) auto}
  .cart-product{grid-column:1/-1}
  .cart-line-total{grid-column:2;grid-row:2}
  .admin-status-form{grid-template-columns:1fr 1fr}
  .admin-btn-save{grid-column:1/-1;width:100%}
}
@media (max-width:800px){
  .thanks-grid{grid-template-columns:1fr}
  .thanks-icon{width:80px;height:80px}
  .thanks-icon svg{width:44px;height:44px}
  .thanks-hero{padding:20px 12px 28px}
  .thanks-card{padding:18px}
  .admin-order-header{flex-direction:column;gap:10px}
  .admin-order-meta{text-align:left}
}
@media (max-width:650px){
  .cart-page{padding:20px 14px}
  .cart-header{align-items:flex-start;flex-direction:column}
  .cart-header h1{font-size:1.6rem}
  .cart-layout{grid-template-columns:minmax(0,1fr)}
  .cart-panel,.cart-summary,.invoice-panel{padding:16px}
  .cart-summary{position:static}
  .cart-item{grid-template-columns:minmax(0,1fr);gap:14px}
  .cart-product{grid-column:auto}
  .cart-item-actions{flex-direction:row;flex-wrap:wrap;align-items:center}
  .cart-line-total{grid-column:auto;grid-row:auto;align-items:flex-start}
  .checkout-fields,.invoice-addresses{grid-template-columns:minmax(0,1fr)}
  .cart-field-full{grid-column:auto}
  .invoice-meta{grid-template-columns:minmax(0,1fr);gap:14px}
  .invoice-header{flex-direction:column}
  .admin-status-form{grid-template-columns:1fr}
}
@media print{
  body{background:#fff!important;color:#111!important}
  .cart-header,.invoice-actions,.cart-eyebrow{print-color-adjust:exact}
  .cart-header,.invoice-actions,.cart-continue,.shop-tabs,.history-dropdown-wrap{display:none!important}
  .cart-page{max-width:none;padding:0;color:#111}
  .invoice-panel{padding:0;border:0;background:#fff;color:#111}
  .invoice-addresses p,.invoice-meta span,.invoice-table th,.invoice-totals span{color:#444}
  .invoice-table th,.invoice-table td,.invoice-header,.invoice-meta,.invoice-grand-total{border-color:#ddd}
  .invoice-status,.invoice-grand-total strong{color:#111}
}
</style>
</BaseLayout>