<BaseLayout
    title="Dashboard"
    auth="true"
    roles="Admin, Editor, User"
    hero='
        <HeroLayout
            badge="VLO DASHBOARD"
            title="Everything you need, in one place."
            subtitle="A practical dashboard demonstrating VLO components, configurable sidebars, reusable layouts, and server-side rendering."
        />'
    footer="<Footer />"
>
    <div class="dashboard-layout">

        <!-- SIDEBAR -->
        <Sidebar
            brand="VLO"
            subtitle="Dashboard"
            width="240px"
            position="left"
            size="medium"
        >
            <a href="/dashboard" class="active">Dashboard</a>
            <a href="/products">Products</a>
            <a href="/users">Users</a>
            <a href="/components">Components</a>
            <a href="/docs">Documentation</a>
            <a href="/">Back to Home</a>
        </Sidebar>

        <!-- CONTENT -->
        <main class="dashboard-content">
        

 <div data-source="/api/dash/get_dashboard_stats">
    {for stat in get_dashboard_stats}
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon">📦</div>
            <div class="stat-content">
                <div class="stat-value">{{stat.total_products}}</div>
                <div class="stat-label">Total Products</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <div class="stat-content">
                <div class="stat-value">${{stat.total_revenue}}</div>
                <div class="stat-label">Total Revenue</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">📊</div>
            <div class="stat-content">
                <div class="stat-value">${{stat.avg_price}}</div>
                <div class="stat-label">Avg Price</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🏷️</div>
            <div class="stat-content">
                <div class="stat-value">{{stat.total_categories}}</div>
                <div class="stat-label">Categories</div>
            </div>
        </div>
    </div>
    {/for}
</div>
           <!-- ═══ STATS SUMMARY ═══ -->
<div data-source="/api/dash/get_dashboard_stats">
    {for stat in dashboard_stats}
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon">📦</div>
            <div class="stat-content">
                <div class="stat-value">{{stat.total_products}}</div>
                <div class="stat-label">Total Products</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <div class="stat-content">
                <div class="stat-value">${{stat.total_revenue}}</div>
                <div class="stat-label">Total Revenue</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">📊</div>
            <div class="stat-content">
                <div class="stat-value">${{stat.avg_price}}</div>
                <div class="stat-label">Avg Price</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🏷️</div>
            <div class="stat-content">
                <div class="stat-value">{{stat.total_categories}}</div>
                <div class="stat-label">Categories</div>
            </div>
        </div>
    </div>
    {/for}
</div>

            <!-- ═══ PRIMARY CHARTS (2-column grid) ═══ -->
            <div class="charts-grid charts-primary">
            <HorizontalBarChart
    source="/api/dash/get_category_stats"
    title="Revenue by Category"
    label_column="category"
    value_column="total_revenue"
    limit="8"
    color="#00f5ff"
/>

<ProgressChart
    source="/api/dash/get_category_stats"
    title="Category Performance"
    label_column="category"
    value_column="product_count"
    limit="8"
    color="#00ff88"
/>
<LollipopChart
    source="/api/dash/get_category_stats"
    title="Products by Category"
    label_column="category"
    value_column="product_count"
    limit="8"
    color="#ffaa00"
/>
                <LineChart 
                    source="/api/dash/get_category_stats"
                    title="Revenue by Category"
                    label_column="category"
                    value_column="total_revenue"
                    limit="8"
                    color="#00f5ff"
                />

                <BarChart 
                    source="/api/dash/get_category_stats"
                    title="Products per Category"
                    label_column="category"
                    value_column="product_count"
                    limit="32"
                    color="#00ff88"
                />
            </div>

            <!-- ═══ SECONDARY CHARTS (3-column grid) ═══ -->
            <div class="charts-grid charts-secondary">
                <BarChart 
                    source="/api/dash/get_stock_status"
                    title="Stock Status"
                    label_column="status"
                    value_column="count"
                    limit="5"
                    color="#ffaa00"
                />

                <BarChart 
                    source="/api/dash/get_price_distribution"
                    title="Price Distribution"
                    label_column="price_range"
                    value_column="count"
                    limit="6"
                    color="#ff6680"
                />

                <LineChart 
                    source="/api/dash/get_monthly_products"
                    title="Monthly Additions"
                    label_column="month"
                    value_column="count"
                    limit="12"
                    color="#a78bfa"
                />
            </div>

            <!-- ═══ DETAILED CHART (full width) ═══ -->
            <div class="charts-grid charts-detailed">
                <BarChart 
                    source="/api/dash/get_products_chart"
                    title="Top 10 Products by Stock"
                    group_by="title"
                    value_column="stock"
                    label_column="title"
                    limit="10"
                    color="#f472b6"
                />
            </div>

            <!-- OVERVIEW -->
            <section class="section">
                <div class="section-label">01 — OVERVIEW</div>
                <div class="stats">
                    <article class="stat-card-simple">
                        <span>PROJECTS</span>
                        <strong>12</strong>
                        <small>Active projects</small>
                    </article>
                    <article class="stat-card-simple">
                        <span>COMPONENTS</span>
                        <strong>10</strong>
                        <small>Reusable components</small>
                    </article>
                    <article class="stat-card-simple">
                        <span>API</span>
                        <strong>Ready</strong>
                        <small>SQL API connected</small>
                    </article>
                    <article class="stat-card-simple">
                        <span>STATUS</span>
                        <strong>Online</strong>
                        <small>VLO server running</small>
                    </article>
                </div>
            </section>

            <!-- RECENT ACTIVITY -->
            <section class="section">
                <div class="section-label">02 — RECENT ACTIVITY</div>
                <div class="activity-list">
                    <div class="activity">
                        <span class="activity-dot"></span>
                        <div>
                            <strong>Dashboard created</strong>
                            <small>VLO automatic layout system</small>
                        </div>
                        <time>Just now</time>
                    </div>
                    <div class="activity">
                        <span class="activity-dot"></span>
                        <div>
                            <strong>Sidebar loaded</strong>
                            <small>Reusable configurable component</small>
                        </div>
                        <time>1 min ago</time>
                    </div>
                    <div class="activity">
                        <span class="activity-dot"></span>
                        <div>
                            <strong>VLO server running</strong>
                            <small>Development environment ready</small>
                        </div>
                        <time>2 min ago</time>
                    </div>
                </div>
            </section>

            <!-- QUICK ACTIONS -->
            <section class="section">
                <div class="section-label">03 — QUICK ACTIONS</div>
                <div class="actions">
                    <a href="/components">
                        <strong>Components</strong>
                        <span>Explore reusable UI →</span>
                    </a>
                    <a href="/docs">
                        <strong>Documentation</strong>
                        <span>Read the VLO docs →</span>
                    </a>
                    <a href="/products">
                        <strong>Products</strong>
                        <span>View product data →</span>
                    </a>
                </div>
            </section>

            <!-- SIDEBAR DEMO -->
            <section class="sidebar-demo">
                <div class="section-label">04 — SIDEBAR COMPONENT</div>
                <h2>Configurable.<br><span>Reusable.</span></h2>
                <p>The sidebar is a normal VLO component. Its position, width and size can be configured directly through props.</p>
                <div class="demo-code">
                    <code>
&lt;Sidebar
    width="240px"
    position="left"
    size="medium"
&gt;
    ...
&lt;/Sidebar&gt;
                    </code>
                </div>
            </section>

            <!-- FINAL -->
            <section class="final-section">
                <div class="vlo-symbol">VLO</div>
                <h2>Build with components.</h2>
                <p>Compose pages from reusable pieces and let VLO handle the rendering.</p>
                <a href="/components" class="btn primary">Explore Components →</a>
            </section>

        </main>
    </div>
</BaseLayout>

<style>
.dashboard-layout {
    display: flex;
    min-height: 700px;
    background: #080808;
    color: #fff;
}

.dashboard-content {
    min-width: 0;
    flex: 1;
    padding: 24px;
}

/* ═══ Stats Row ═══ */
.stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 24px 0;
}

.stat-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: rgba(255,255,255,.02);
    border: 1px solid #292929;
    border-radius: 10px;
    transition: border-color 0.2s;
}

.stat-card:hover {
    border-color: rgba(0, 245, 255, 0.3);
}

.stat-icon {
    font-size: 28px;
    line-height: 1;
}

.stat-content {
    flex: 1;
}

.stat-value {
    font-size: 20px;
    font-weight: 700;
    color: #eee;
    line-height: 1.2;
}

.stat-label {
    font-size: 12px;
    color: #888;
    margin-top: 2px;
}

/* ═══ Charts Grid ═══ */
.charts-grid {
    gap: 20px;
    margin-bottom: 20px;
}

.charts-grid .vlo-chart {
    margin: 0;
}

.charts-primary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
}

.charts-secondary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
}

.charts-detailed {
    display: grid;
    grid-template-columns: 1fr;
}

/* ═══ Dashboard Sections ═══ */
.section {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
}

.section-label {
    color: #00f5ff;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .12em;
    margin-bottom: 20px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.stat-card-simple {
    padding: 20px;
    border: 1px solid #292929;
    border-radius: 10px;
    background: rgba(255,255,255,.018);
}

.stat-card-simple span {
    display: block;
    color: #555;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .1em;
}

.stat-card-simple strong {
    display: block;
    margin: 8px 0 4px;
    color: #fff;
    font-size: 1.5rem;
}

.stat-card-simple small {
    color: #666;
    font-size: .7rem;
}

.activity-list {
    border-top: 1px solid #292929;
}

.activity {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid #292929;
}

.activity-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #00f5ff;
}

.activity div {
    flex: 1;
}

.activity strong {
    display: block;
    color: #ddd;
    font-size: .78rem;
}

.activity small,
.activity time {
    color: #666;
    font-size: .68rem;
}

.activity time {
    white-space: nowrap;
}

.actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.actions a {
    padding: 20px;
    border: 1px solid #292929;
    border-radius: 10px;
    text-decoration: none;
    transition: .2s;
}

.actions a:hover {
    border-color: #00f5ff;
    transform: translateY(-2px);
}

.actions strong {
    display: block;
    color: #ddd;
    font-size: .8rem;
}

.actions span {
    display: block;
    margin-top: 6px;
    color: #666;
    font-size: .7rem;
}

.sidebar-demo {
    max-width: 1100px;
    margin: 50px auto;
    padding: 0 20px;
}

.sidebar-demo h2 {
    margin: 16px 0 12px;
    color: #fff;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: .95;
    letter-spacing: -.05em;
}

.sidebar-demo h2 span {
    color: #00f5ff;
}

.sidebar-demo p {
    max-width: 650px;
    color: #777;
    line-height: 1.7;
    font-size: .85rem;
}

.demo-code {
    max-width: 600px;
    margin-top: 24px;
    padding: 18px;
    overflow-x: auto;
    border: 1px solid #292929;
    border-radius: 10px;
    background: #090909;
}

.demo-code code {
    color: #b9f8ff;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .75rem;
    line-height: 1.7;
}

.final-section {
    max-width: 1100px;
    margin: 60px auto;
    padding: 0 20px 80px;
    text-align: center;
}

.vlo-symbol {
    color: #00f5ff;
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: -.08em;
    text-shadow: 0 0 25px rgba(0,245,255,.25);
}

.final-section h2 {
    margin: 12px 0 8px;
    color: #fff;
    font-size: 1.7rem;
}

.final-section p {
    margin: 0 auto 20px;
    color: #666;
    font-size: .78rem;
}

.btn {
    display: inline-flex;
    padding: 11px 16px;
    border-radius: 8px;
    text-decoration: none;
    font-size: .78rem;
    font-weight: 700;
}

.btn.primary {
    background: #00f5ff;
    color: #000;
}

/* ═══ Responsive ═══ */
@media (max-width: 960px) {
    .charts-primary,
    .charts-secondary {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 900px) {
    .stats {
        grid-template-columns: repeat(2, 1fr);
    }
    .actions {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {
    .dashboard-layout {
        display: block;
    }
    .dashboard-content {
        padding: 16px;
    }
    .stats-row {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }
    .stat-card {
        padding: 14px;
    }
    .stat-icon {
        font-size: 24px;
    }
    .stat-value {
        font-size: 18px;
    }
    .stats {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 550px) {
    .activity {
        align-items: flex-start;
    }
    .activity time {
        display: none;
    }
}
</style>