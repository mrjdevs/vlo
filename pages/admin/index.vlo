<BaseLayout title="Email System" auth="true" roles="Admin">
<meta name="vlo-csrf-patch" content="1">
  <div class="admin-page">

    <!-- ══════════════════════════ HEADER ══════════════════════════ -->
    <header class="admin-header">
      <div class="admin-eyebrow">
        <span class="pulse-dot"></span> AUTOMATION ENGINE
      </div>
      <div class="admin-title-row">
        <h1>Email System</h1>
        <div class="header-actions">
          {if flash_messages}<Toast duration="short" />{/if}
          <a href="/admin/files" class="btn btn-secondary">All Files →</a>
        </div>
      </div>
      <p class="admin-subtitle">
        Rules decide <em>when</em> to email. Templates decide <em>what</em> to say.
        Both live here — no code required.
      </p>

      <!-- Live stats -->
      <div data-source="/api/email_rules">
        <div class="stats-row">
          <div class="stat">
            <span class="stat-label">Total Rules</span>
            <strong class="stat-value">{{ email_rules.0.total | default:0 }}</strong>
          </div>
          <div class="stat">
            <span class="stat-label">Active</span>
            <strong class="stat-value stat-success">{{ email_rules.0.active | default:0 }}</strong>
          </div>
          <div class="stat">
            <span class="stat-label">Paused</span>
            <strong class="stat-value stat-muted">{{ email_rules.0.paused | default:0 }}</strong>
          </div>
        </div>
      </div>
    </header>

    <!-- ══════════════════════════ TABS ══════════════════════════ -->
    <nav class="tabs">
      <a href="/admin/?tab=rules" class="tab {if tab != 'templates'}active{/if}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16v16H4z"></path><path d="M4 9h16M9 4v16"></path>
        </svg>
        Rules
      </a>
      <a href="/admin/?tab=templates" class="tab {if tab == 'templates'}active{/if}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        Templates
      </a>
    </nav>

    <!-- ══════════════════════════ RULES TAB ══════════════════════════ -->
    {if tab != "templates"}
      <div class="tab-content">

        <div class="tab-toolbar">
          <button type="button" class="btn btn-primary" data-modal-open="add-rule-modal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            New Rule
          </button>
        </div>

        <div id="rules-wrapper">
          {{ "" | ajax:",0,#rules-wrapper,html" }}

          <div data-source="/api/email_rules">
            {if email_rules}
              <div class="rules-grid">
                {for rule in email_rules}
                  <article class="rule-card {if rule.enabled == 0}rule-paused{/if}">

                    <div class="rule-status {if rule.enabled == 1}status-on{else}status-off{/if}">
                      <span class="status-dot"></span>
                      {if rule.enabled == 1}Active{else}Paused{/if}
                    </div>

                    <div class="rule-flow">
                      <span class="flow-badge flow-event">{{ rule.event_type }}</span>
                      <span class="flow-arrow">→</span>
                      <a href="/admin/?tab=templates&file=email_templates/{{ rule.template }}.html" class="flow-badge flow-template" title="Open template">
                        {{ rule.template }}
                      </a>
                    </div>

                    <div class="rule-recipient">
                      <span class="rule-label">To</span>
                      <code>{{ rule.recipient }}</code>
                    </div>

                    <div class="rule-meta">
                      {if rule.condition_path}
                        <div class="meta-item">
                          <span class="meta-label">If</span>
                          <code>{{ rule.condition_path }} {{ rule.condition_op }} {{ rule.condition_val }}</code>
                        </div>
                      {/if}
                      {if rule.delay_minutes > 0}
                        <div class="meta-item">
                          <span class="meta-label">Delay</span>
                          <code>{{ rule.delay_minutes }}m</code>
                        </div>
                      {/if}
                      <div class="meta-item">
                        <span class="meta-label">Dedup</span>
                        <code>{if rule.dedup_minutes == -1}once{else if rule.dedup_minutes == 0}every{else}per {{ rule.dedup_minutes }}m{/if}</code>
                      </div>
                    </div>

                    <div class="rule-actions">
                      <form v-put="/api/email_rules/{{ rule.id }}" class="toggle-form">
                        <input type="hidden" name="enabled" value="{if rule.enabled == 1}0{else}1{/if}">
                        <button type="submit" class="toggle-btn {if rule.enabled == 1}toggle-on{else}toggle-off{/if}">
                          <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </button>
                      </form>
                      <button type="button" class="icon-btn icon-btn-danger" data-modal-open="del-rule-{{ rule.id }}" title="Delete">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                        </svg>
                      </button>
                    </div>

                    <Modal id="del-rule-{{ rule.id }}" title="Delete Rule">
                      <div class="delete-confirmation">
                        <p>Delete the <strong>{{ rule.template }}</strong> rule?</p>
                        <p class="text-danger">Any pending emails for this rule will still send.</p>
                        <div class="modal-actions">
                          <button type="button" class="btn btn-secondary" data-modal-close="del-rule-{{ rule.id }}">Cancel</button>
                          <button type="button" class="btn btn-danger-solid" v-delete="/api/email_rules/{{ rule.id }}">Delete</button>
                        </div>
                      </div>
                    </Modal>

                  </article>
                {/for}
              </div>
            {else}
              <div class="empty-state">
                <div class="empty-icon">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </div>
                <h2>No rules yet</h2>
                <p>Add a rule to start dispatching emails automatically.</p>
                <button type="button" class="btn btn-primary" data-modal-open="add-rule-modal">Add Your First Rule</button>
              </div>
            {/if}
          </div>
        </div>

      </div>
    {/if}

    <!-- ══════════════════════════ TEMPLATES TAB ══════════════════════════ -->
    {if tab == "templates"}
      <div class="tab-content tab-content-templates">

        <div class="tpl-layout">

          <!-- LEFT: File list -->
          <aside class="tpl-sidebar">
            <div class="tpl-sidebar-head">
              <span>Templates</span>
              <button id="btn-new-tpl" class="icon-btn" title="New template">+</button>
            </div>
            <ul id="tpl-list" class="tpl-list">
              <li class="tpl-loading">Loading…</li>
            </ul>
          </aside>

          <!-- RIGHT: Editor + Preview -->
          <section class="tpl-editor">
            <div class="tpl-toolbar">
              <input id="tpl-path" type="text" placeholder="email_templates/name.html" readonly>
              <span id="tpl-status" class="tpl-status"></span>
              <button id="btn-save-tpl" class="btn btn-primary">Save</button>
              <button id="btn-del-tpl" class="btn btn-danger">Delete</button>
            </div>

            <div class="tpl-split">
              <textarea id="tpl-content" class="tpl-textarea" spellcheck="false" placeholder="Select a template to edit, or click + to create one."></textarea>
              <iframe id="tpl-preview" class="tpl-preview" sandbox="" title="Preview"></iframe>
            </div>

            <div class="tpl-hint">
              <span><code>{{name}}</code> variable</span>
              <span><code>{if ...}...{/if}</code> condition</span>
              <span><code>&lt;!-- subject: ... --&gt;</code> first line</span>
            </div>
          </section>

        </div>

      </div>
    {/if}

  </div>

  <!-- ══════════════════════════ ADD RULE MODAL ══════════════════════════ -->
  <Modal id="add-rule-modal" title="New Email Rule">
    <form v-post="/api/email_rules" class="rule-form" alert="false">
      <div class="form-grid">
        <div class="form-field">
          <label for="event_type">Event</label>
          <input id="event_type" name="event_type" list="event-suggestions" placeholder="order.created" required autocomplete="off">
          <datalist id="event-suggestions">
            <option value="order.created"><option value="order.updated"><option value="order.deleted">
            <option value="order.shipped"><option value="order.delivered"><option value="order.cancelled">
            <option value="user.registered"><option value="cart_item.created"><option value="payment.received">
          </datalist>
        </div>
        <div class="form-field">
          <label for="template">Template</label>
          <input id="template" name="template" list="template-suggestions" placeholder="order_confirmation" required autocomplete="off">
          <datalist id="template-suggestions"></datalist>
        </div>
        <div class="form-field form-full">
          <label for="recipient">Recipient</label>
          <input id="recipient" name="recipient" placeholder="$.customer_email or admin@site.com" required autocomplete="off">
        </div>
      </div>

      <details class="advanced-section">
        <summary>Advanced</summary>
        <div class="form-grid">
          <div class="form-field">
            <label>Delay (min)</label>
            <input name="delay_minutes" type="number" min="0" value="0">
          </div>
          <div class="form-field">
            <label>Dedup (min)</label>
            <input name="dedup_minutes" type="number" value="-1">
          </div>
          <div class="form-field">
            <label>Condition path</label>
            <input name="condition_path" placeholder="$.total" autocomplete="off">
          </div>
          <div class="form-field">
            <label>Operator</label>
            <select name="condition_op">
              <option value="">—</option>
              <option value="&gt;">&gt;</option>
              <option value="&gt;=">&gt;=</option>
              <option value="&lt;">&lt;</option>
              <option value="&lt;=">&lt;=</option>
              <option value="==">==</option>
              <option value="!=">!=</option>
            </select>
          </div>
          <div class="form-field form-full">
            <label>Condition value</label>
            <input name="condition_val" placeholder="500" autocomplete="off">
          </div>
        </div>
      </details>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" data-modal-close="add-rule-modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Rule</button>
      </div>
    </form>
  </Modal>

  <!-- ══════════════════════════ STYLES ══════════════════════════ -->
  <style>
.admin-page{max-width:1300px;margin:0 auto;padding:40px 24px 80px;color:#e5e5e5;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif}
.admin-header{margin-bottom:28px}
.admin-eyebrow{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;letter-spacing:.06em;color:#00f5ff;text-transform:uppercase;margin-bottom:10px}
.pulse-dot{width:6px;height:6px;border-radius:50%;background:#00f5ff;box-shadow:0 0 8px #00f5ff;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.admin-title-row{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.admin-title-row h1{margin:0;font-size:32px;font-weight:700;color:#fff;letter-spacing:-.02em}
.header-actions{display:flex;align-items:center;gap:12px}
.admin-subtitle{margin:12px 0 0;color:#888;font-size:14px;line-height:1.6;max-width:720px}
.admin-subtitle em{color:#00f5ff;font-style:normal;font-weight:600}
.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px;max-width:600px}
.stat{display:flex;flex-direction:column;gap:4px;padding:16px 20px;background:#0f0f0f;border:1px solid #232323;border-radius:10px}
.stat-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:#666}
.stat-value{font-size:24px;font-weight:700;color:#fff;font-family:ui-monospace,monospace;line-height:1}
.stat-success{color:#00ff88}
.stat-muted{color:#666}

.tabs{display:flex;gap:4px;margin-bottom:24px;border-bottom:1px solid #232323}
.tab{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;text-decoration:none;color:#888;font-size:13px;font-weight:600;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .2s}
.tab:hover{color:#ccc}
.tab.active{color:#00f5ff;border-bottom-color:#00f5ff}
.tab svg{opacity:.8}
.tab-content{animation:fadeIn .2s ease-out}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
.tab-toolbar{display:flex;justify-content:flex-end;margin-bottom:16px}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:9px 16px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:all .2s;font-family:inherit;text-decoration:none}
.btn-primary{background:#00f5ff;color:#000;box-shadow:0 4px 12px rgba(0,245,255,.15)}
.btn-primary:hover{background:#00d8e0;transform:translateY(-1px)}
.btn-secondary{background:transparent;border:1px solid #444;color:#ccc}
.btn-secondary:hover{border-color:#00f5ff;color:#00f5ff}
.btn-danger{background:transparent;border:1px solid #ff4444;color:#ff4444}
.btn-danger:hover{background:rgba(255,68,68,.1)}
.btn-danger-solid{background:rgba(255,68,68,.1);color:#ff4444;border:1px solid rgba(255,68,68,.3)}
.icon-btn{display:grid;place-items:center;width:32px;height:32px;background:transparent;border:1px solid #333;color:#888;border-radius:6px;cursor:pointer;transition:all .2s;font-size:16px;line-height:1}
.icon-btn:hover{border-color:#00f5ff;color:#00f5ff;background:rgba(0,245,255,.05)}
.icon-btn-danger:hover{border-color:#ff4444;color:#ff4444;background:rgba(255,68,68,.05)}

/* RULES GRID */
.rules-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px}
.rule-card{position:relative;background:#0f0f0f;border:1px solid #232323;border-radius:14px;padding:20px;transition:all .25s ease;animation:fadeIn .3s ease-out}
.rule-card:hover{border-color:#333;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.4)}
.rule-card.rule-paused{opacity:.65}
.rule-status{position:absolute;top:16px;right:16px;display:flex;align-items:center;gap:6px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.status-dot{width:6px;height:6px;border-radius:50%}
.status-on .status-dot{background:#00ff88;box-shadow:0 0 6px #00ff88}
.status-on{color:#00ff88}
.status-off{color:#666}
.status-off .status-dot{background:#444}
.rule-flow{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap;padding-right:80px}
.flow-badge{display:inline-block;padding:5px 10px;border-radius:6px;font-family:ui-monospace,monospace;font-size:12px;font-weight:600;text-decoration:none}
.flow-event{background:rgba(0,245,255,.08);color:#00f5ff;border:1px solid rgba(0,245,255,.25)}
.flow-template{background:rgba(167,139,250,.08);color:#a78bfa;border:1px solid rgba(167,139,250,.25);transition:all .2s}
.flow-template:hover{background:rgba(167,139,250,.15);border-color:rgba(167,139,250,.5)}
.flow-arrow{color:#444;font-size:16px;font-weight:700}
.rule-recipient{display:flex;align-items:baseline;gap:8px;margin-bottom:14px}
.rule-label{font-size:11px;font-weight:600;color:#666;text-transform:uppercase;letter-spacing:.05em}
.rule-recipient code{color:#ddd;font-family:ui-monospace,monospace;font-size:12px}
.rule-meta{display:flex;flex-direction:column;gap:6px;padding:12px;background:#080808;border-radius:8px;margin-bottom:14px}
.meta-item{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:12px}
.meta-label{color:#555;font-weight:600;text-transform:uppercase;letter-spacing:.04em;font-size:10px}
.meta-item code{color:#aaa;font-family:ui-monospace,monospace;font-size:11px;text-align:right}
.rule-actions{display:flex;align-items:center;justify-content:space-between;gap:8px;padding-top:12px;border-top:1px solid #1a1a1a}
.toggle-form{margin:0}
.toggle-btn{background:transparent;border:none;padding:0;cursor:pointer;display:flex;align-items:center}
.toggle-track{display:block;position:relative;width:36px;height:20px;background:#333;border-radius:10px;transition:background .2s}
.toggle-thumb{position:absolute;top:2px;left:2px;width:16px;height:16px;background:#fff;border-radius:50%;transition:transform .2s}
.toggle-btn.toggle-on .toggle-track{background:#00ff88}
.toggle-btn.toggle-on .toggle-thumb{transform:translateX(16px)}

.empty-state{text-align:center;padding:64px 24px;background:#0f0f0f;border:1px dashed #333;border-radius:16px}
.empty-icon{color:#333;margin-bottom:20px}
.empty-state h2{margin:0 0 10px;color:#fff;font-size:22px}
.empty-state p{margin:0 0 28px;color:#888;font-size:14px}
.text-danger{color:#ff8888;font-size:12px}
.delete-confirmation{text-align:center}
.delete-confirmation p{margin:0 0 12px;color:#ccc;font-size:14px;line-height:1.6}
.modal-actions{display:flex;justify-content:center;gap:10px;margin-top:20px}

/* TEMPLATES TAB */
.tab-content-templates{height:calc(100vh - 340px);min-height:500px}
.tpl-layout{display:grid;grid-template-columns:260px 1fr;gap:12px;height:100%}
.tpl-sidebar{background:#0f0f0f;border:1px solid #232323;border-radius:10px;overflow:hidden;display:flex;flex-direction:column}
.tpl-sidebar-head{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid #232323;background:#0a0a0a;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#888}
.tpl-sidebar-head .icon-btn{width:24px;height:24px;font-size:14px;border-radius:5px}
.tpl-list{list-style:none;margin:0;padding:6px;overflow-y:auto;flex:1;font-size:13px}
.tpl-list li{padding:7px 10px;border-radius:5px;cursor:pointer;font-family:ui-monospace,monospace;font-size:12px;color:#aaa;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:background .15s}
.tpl-list li:hover{background:#1a1a1a;color:#a78bfa}
.tpl-list li.active{background:rgba(167,139,250,.1);color:#a78bfa}
.tpl-loading{color:#555;font-style:italic;cursor:default;padding:14px}
.tpl-editor{background:#0f0f0f;border:1px solid #232323;border-radius:10px;overflow:hidden;display:flex;flex-direction:column}
.tpl-toolbar{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid #232323;background:#0a0a0a;flex-wrap:wrap}
.tpl-toolbar input{flex:1;min-width:200px;padding:7px 10px;background:#050505;border:1px solid #333;border-radius:6px;color:#a78bfa;font-family:ui-monospace,monospace;font-size:12px;outline:none}
.tpl-toolbar input:focus{border-color:#a78bfa}
.tpl-status{font-size:11px;color:#666;min-width:60px}
.tpl-status.ok{color:#00ff88}
.tpl-status.err{color:#ff4444}
.tpl-split{flex:1;display:grid;grid-template-columns:1fr 1fr;min-height:0}
.tpl-textarea{background:#050505;border:none;outline:none;color:#b9f8ff;font-family:ui-monospace,monospace;font-size:12.5px;line-height:1.55;padding:14px;resize:none;tab-size:2;border-right:1px solid #232323;min-height:0}
.tpl-preview{background:#fff;border:none;min-height:0;width:100%}
.tpl-hint{padding:8px 12px;border-top:1px solid #232323;background:#0a0a0a;display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:#555}
.tpl-hint code{background:#1a1a1a;padding:1px 5px;border-radius:3px;color:#888;font-family:ui-monospace,monospace}

/* RULE FORM */
.rule-form{display:flex;flex-direction:column;gap:18px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-field{display:flex;flex-direction:column;gap:6px}
.form-field label{font-size:12px;font-weight:600;color:#ccc}
.form-field input,.form-field select{padding:10px 12px;background:#050505;border:1px solid #333;border-radius:7px;color:#fff;font-size:13px;outline:none;transition:border-color .2s;font-family:inherit;width:100%;box-sizing:border-box}
.form-field input:focus,.form-field select:focus{border-color:#00f5ff;box-shadow:0 0 0 3px rgba(0,245,255,.1)}
.form-full{grid-column:1/-1}
.advanced-section{background:#0a0a0a;border:1px solid #232323;border-radius:8px}
.advanced-section summary{padding:12px 16px;cursor:pointer;font-size:13px;font-weight:600;color:#888;list-style:none}
.advanced-section summary::-webkit-details-marker{display:none}
.advanced-section summary:hover{color:#00f5ff}
.advanced-section summary::before{content:"▸ ";margin-right:6px}
.advanced-section[open] summary::before{content:"▾ "}
.advanced-section>div{padding:0 16px 16px}

@media (max-width:900px){.tpl-layout{grid-template-columns:1fr}.tpl-split{grid-template-columns:1fr;grid-template-rows:1fr 1fr}.tab-content-templates{height:auto}.tpl-textarea{border-right:none;border-bottom:1px solid #232323;min-height:300px}.tpl-preview{min-height:300px}}
@media (max-width:700px){.form-grid{grid-template-columns:1fr}.stats-row{grid-template-columns:1fr}.rules-grid{grid-template-columns:1fr}}
  </style>

  <!-- ══════════════════════════ JS ══════════════════════════ -->
  <script>
(function() {
  // ═══ TEMPLATES TAB LOGIC ═══
  const listEl     = document.getElementById('tpl-list');
  const pathEl     = document.getElementById('tpl-path');
  const contentEl  = document.getElementById('tpl-content');
  const previewEl  = document.getElementById('tpl-preview');
  const statusEl   = document.getElementById('tpl-status');
  const saveBtn    = document.getElementById('btn-save-tpl');
  const delBtn     = document.getElementById('btn-del-tpl');
  const newBtn     = document.getElementById('btn-new-tpl');
  const templateDl = document.getElementById('template-suggestions');

  function setStatus(msg, kind) {
    if (!statusEl) return;
    statusEl.textContent = msg || '';
    statusEl.className = 'tpl-status' + (kind ? ' ' + kind : '');
    if (msg) setTimeout(() => { if (statusEl.textContent === msg) setStatus(''); }, 2500);
  }

  function updatePreview() {
    if (!previewEl || !contentEl) return;
    // Strip subject comment for a cleaner preview
    const html = contentEl.value.replace(/<!--\s*subject:.*?-->/i, '');
    previewEl.srcdoc = html;
  }

  async function loadTemplateList() {
    if (!listEl) return;
    listEl.innerHTML = '<li class="tpl-loading">Loading…</li>';
    try {
      const r = await fetch('/api/_files?prefix=email_templates');
      const j = await r.json();
      if (!j.success) throw new Error(j.error || 'Failed');
      listEl.innerHTML = '';
      const templates = j.data.filter(x => x.type === 'file' && x.path.startsWith('email_templates/'));
      for (const t of templates) {
        const name = t.path.replace('email_templates/', '').replace('.html', '');
        const li = document.createElement('li');
        li.textContent = name;
        li.dataset.path = t.path;
        li.addEventListener('click', () => openFile(t.path));
        if (pathEl && pathEl.value === t.path) li.classList.add('active');
        listEl.appendChild(li);
        // populate datalist
        if (templateDl) {
          const opt = document.createElement('option');
          opt.value = name;
          templateDl.appendChild(opt);
        }
      }
      if (templates.length === 0) {
        listEl.innerHTML = '<li class="tpl-loading" style="padding:14px">No templates yet.<br>Click <strong>+</strong> to create one.</li>';
      }
    } catch (e) {
      listEl.innerHTML = '<li class="tpl-loading" style="color:#ff4444">' + e.message + '</li>';
    }
  }

  async function openFile(path) {
    if (!path) return;
    // Simple unsaved-changes check
    if (pathEl && pathEl.value && pathEl.value !== path && contentEl.value.trim() && !confirm('Discard unsaved changes?')) return;
    try {
      const r = await fetch('/api/_files/' + path);
      const j = await r.json();
      if (!j.success) throw new Error(j.error || 'Failed');
      pathEl.value = path;
      contentEl.value = j.data[0].content;
      document.querySelectorAll('.tpl-list li').forEach(li => li.classList.remove('active'));
      const active = document.querySelector('.tpl-list li[data-path="' + path + '"]');
      if (active) active.classList.add('active');
      updatePreview();
      setStatus('Loaded', 'ok');
    } catch (e) {
      setStatus(e.message, 'err');
    }
  }

  async function saveFile() {
    if (!pathEl || !pathEl.value) { setStatus('No file', 'err'); return; }
    saveBtn.disabled = true;
    try {
      const r = await fetch('/api/_files/' + pathEl.value, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json'},
        body: JSON.stringify({ content: contentEl.value })
      });
      const j = await r.json();
      if (!j.success) throw new Error(j.error || 'Save failed');
      setStatus('Saved', 'ok');
      await loadTemplateList();
    } catch (e) {
      setStatus(e.message, 'err');
    } finally {
      saveBtn.disabled = false;
    }
  }

  async function deleteFile() {
    if (!pathEl || !pathEl.value) return;
    if (!confirm('Delete ' + pathEl.value + '?')) return;
    delBtn.disabled = true;
    try {
      const r = await fetch('/api/_files/' + pathEl.value, { method: 'DELETE' });
      const j = await r.json();
      if (!j.success) throw new Error(j.error || 'Delete failed');
      contentEl.value = '';
      pathEl.value = '';
      updatePreview();
      setStatus('Deleted', 'ok');
      await loadTemplateList();
    } catch (e) {
      setStatus(e.message, 'err');
    } finally {
      delBtn.disabled = false;
    }
  }

  function newTemplate() {
    const name = prompt('Template name (no .html):', 'my_template');
    if (!name) return;
    const clean = name.trim().replace(/[^a-z0-9_-]/gi, '_').replace(/\.html$/i, '');
    if (!clean) return;
    pathEl.value = 'email_templates/' + clean + '.html';
    contentEl.value = '<!-- subject: Your subject with {{name}} -->\n<h1>Hi {{name}},</h1>\n<p>Your message here.</p>';
    updatePreview();
    setStatus('Ready to save new file');
  }

  // Wire up
  if (saveBtn) saveBtn.addEventListener('click', saveFile);
  if (delBtn) delBtn.addEventListener('click', deleteFile);
  if (newBtn) newBtn.addEventListener('click', newTemplate);
  if (contentEl) {
    let previewTimer = null;
    contentEl.addEventListener('input', () => {
      clearTimeout(previewTimer);
      previewTimer = setTimeout(updatePreview, 300);
    });
    contentEl.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveFile(); }
      if (e.key === 'Tab') {
        e.preventDefault();
        const s = contentEl.selectionStart, en = contentEl.selectionEnd;
        contentEl.value = contentEl.value.substring(0, s) + '  ' + contentEl.value.substring(en);
        contentEl.selectionStart = contentEl.selectionEnd = s + 2;
      }
    });
  }

  // On templates tab: load list + optionally auto-open file from ?file=
  if (listEl) {
    loadTemplateList().then(() => {
      const params = new URLSearchParams(window.location.search);
      const file = params.get('file');
      if (file) openFile(file);
    });
  }
})();
  </script>
</BaseLayout>