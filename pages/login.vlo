<BaseLayout title="Login" guest="true">
    <div class="auth-page">
        <div class="auth-glow"></div>

        <div class="auth-card">
            <div class="auth-badge">
                <span class="pulse"></span>
                SECURE ACCESS
            </div>

            <h1>Login to <span>VLO</span>.</h1>

            <p class="auth-lead">
                Sign in to manage your projects, dashboards and content.
            </p>

            {if status == "error" || error}
                <div class="auth-alert">
                    <span>!</span>
                    <p>{{error}}</p>
                </div>
            {/if}

            <form v-post="/api/auth/login" class="auth-form">
                <Input 
                    class="auth-field"
                    label="{{auth_identifier_field|upper}}" 
                    name="{{auth_identifier_field}}" 
                    type="text" 
                    id="identifier"
                    placeholder="Email or username" 
                    required 
                />

                <Input 
                    class="auth-field"
                    label="{{auth_password_field|upper}}" 
                    name="{{auth_password_field}}" 
                    type="password" 
                    id="password"
                    placeholder="••••••••" 
                    required 
                />
                
                <div class="auth-field auth-remember">
                    <label class="auth-checkbox-label">
                        <input type="checkbox" name="remember_me" value="true" />
                        <span class="auth-checkbox-custom"></span>
                        <span>Remember me for 30 days</span>
                    </label>
                </div>

                <button type="submit" class="auth-submit">Sign In →</button>
            </form>

            <div class="auth-footer">
                <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                    <a href="#modal-forgot">Forgot password?</a>
                    <a href="#modal-register">Create account</a>
                </div>
                <a href="/">← Back to Home</a>
            </div>
        </div>

        <!-- =========================================
             REGISTER MODAL
        ========================================= -->
        <div id="modal-register" class="auth-modal">
            <div class="auth-modal-content">
                <a href="#" class="auth-modal-close">×</a>
                <h2>Create Account</h2>
                <p>Join VLO to start building zero-boilerplate applications.</p>
                <form v-post="/api/auth/register" class="auth-form">
                    <Input class="auth-field" label="Full Name" name="name" type="text" placeholder="John Doe" required />
                    <Input class="auth-field" label="{{auth_identifier_field|upper}}" name="{{auth_identifier_field}}" type="email" placeholder="you@example.com" required />
                    <Input class="auth-field" label="{{auth_password_field|upper}}" name="{{auth_password_field}}" type="password" placeholder="••••••••" required />
                    <button type="submit" class="auth-submit">Create Account →</button>
                </form>
                <div class="auth-footer" style="justify-content: center; margin-top: 20px; border: none; padding-top: 0;">
                    <a href="#">← Back to Login</a>
                </div>
            </div>
        </div>

        <!-- =========================================
             FORGOT PASSWORD MODAL
        ========================================= -->
        <div id="modal-forgot" class="auth-modal">
            <div class="auth-modal-content">
                <a href="#" class="auth-modal-close">×</a>
                <h2>Reset Password</h2>
                <p>Enter your email address and we'll send you a secure link to reset your password.</p>
                <form v-post="/api/auth/forgot-password" class="auth-form">
                    <Input class="auth-field" label="{{auth_identifier_field|upper}}" name="{{auth_identifier_field}}" type="email" placeholder="you@example.com" required />
                    <button type="submit" class="auth-submit">Send Reset Link →</button>
                </form>
                <div class="auth-footer" style="justify-content: center; margin-top: 20px; border: none; padding-top: 0;">
                    <a href="#">← Back to Login</a>
                </div>
            </div>
        </div>

        <!-- =========================================
             RESET PASSWORD MODAL
        ========================================= -->
        <div id="modal-reset" class="auth-modal">
            <div class="auth-modal-content">
                <a href="/login" class="auth-modal-close">×</a>
                <h2>Set New Password</h2>
                <p>Please enter your new password below.</p>
                <form v-post="/api/auth/reset-password" class="auth-form">
                    <input type="hidden" name="token" id="reset-token-input" value="" />
                    <Input class="auth-field" label="New Password" name="new_password" type="password" placeholder="••••••••" required />
                    <button type="submit" class="auth-submit">Update Password →</button>
                </form>
                <div class="auth-footer" style="justify-content: center; margin-top: 20px; border: none; padding-top: 0;">
                    <a href="/login">← Back to Login</a>
                </div>
            </div>
        </div>

        <!-- =========================================
             RESEND ACTIVATION MODAL (NEW)
        ========================================= -->
        <div id="modal-resend-activation" class="auth-modal">
            <div class="auth-modal-content">
                <a href="#" class="auth-modal-close">×</a>
                <h2>Resend Activation Link</h2>
                <p>Enter your email address and we'll send you a new activation link.</p>
                <form id="resend-activation-form" class="auth-form">
                    <Input 
                        class="auth-field"
                        label="{{auth_identifier_field|upper}}" 
                        name="{{auth_identifier_field}}" 
                        type="email" 
                        id="resend-email"
                        placeholder="you@example.com" 
                        required 
                    />
                    <button type="submit" class="auth-submit">Send Activation Link →</button>
                </form>
                <div class="auth-footer" style="justify-content: center; margin-top: 20px; border: none; padding-top: 0;">
                    <a href="#">← Back to Login</a>
                </div>
            </div>
        </div>

    </div>
</BaseLayout>

<script>

    // 1. Auto-populate reset token from URL and open modal if present
    (function() {
        const urlParams = new URLSearchParams(window.location.search);
        const token = urlParams.get('token');
        if (token) {
            const tokenInput = document.getElementById('reset-token-input');
            if (tokenInput) {
                tokenInput.value = token;
                window.location.hash = 'modal-reset';
            }
        }
    })();

    // 2. Resend Activation Modal Logic
    function openResendActivationModal() {
        window.location.hash = 'modal-resend-activation';
    }

    document.getElementById('resend-activation-form')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = e.target.querySelector('button[type="submit"]');
        const originalText = btn.innerText;
        btn.innerText = 'Sending...';
        btn.disabled = true;

        const formData = new FormData(e.target);
        
        try {
            const response = await fetch('/api/auth/resend-activation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(formData)
            });
            const data = await response.json();
            
            if (data.success) {
                alert(data.message || 'Activation link sent!');
                window.location.hash = ''; // Close modal
                e.target.reset();
            } else {
                alert(data.error || 'Failed to send activation link.');
            }
        } catch (err) {
            console.error(err);
            alert('Network error. Please try again.');
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    });
</script>


<style>
/* (Keep all your existing CSS exactly as it was, plus add this for the modal button if needed) */
.auth-modal .auth-submit { margin-top: 10px; }

/* =========================================
   PAGE & GLOW
========================================= */
.auth-page {
    position: relative;
    min-height: calc(100vh - 140px);
    display: grid;
    place-items: center;
    padding: 60px 24px;
    overflow: hidden;
}

.auth-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(0,245,255,.08), transparent 45%);
    pointer-events: none;
}

/* =========================================
   CARD
========================================= */
.auth-card {
    position: relative;
    width: 100%;
    max-width: 420px;
    padding: 40px 34px;
    border: 1px solid rgba(0,245,255,.16);
    border-radius: 15px;
    background: rgba(255,255,255,.02);
    backdrop-filter: blur(6px);
}

.auth-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 13px;
    border: 1px solid rgba(0,245,255,.25);
    border-radius: 999px;
    background: rgba(0,245,255,.05);
    color: #00f5ff;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
}

.pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00f5ff;
    box-shadow: 0 0 12px #00f5ff;
}

.auth-card h1 {
    margin: 22px 0 10px;
    font-size: clamp(2rem, 6vw, 2.6rem);
    line-height: .95;
    letter-spacing: -.05em;
    color: #fff;
}

.auth-card h1 span {
    color: #00f5ff;
    text-shadow: 0 0 30px rgba(0,245,255,.25);
}

.auth-lead {
    margin: 0 0 28px;
    color: #858585;
    font-size: .85rem;
    line-height: 1.65;
}

/* =========================================
   ERROR ALERT
========================================= */
.auth-alert {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 15px;
    margin-bottom: 20px;
    border: 1px solid rgba(255,92,122,.25);
    border-radius: 10px;
    background: rgba(255,92,122,.05);
}

.auth-alert > span {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 7px;
    background: rgba(255,92,122,.1);
    color: #ff6680;
    font-weight: 700;
    font-size: .8rem;
}

.auth-alert p {
    margin: 0;
    color: #ff8fa3;
    font-size: .78rem;
    line-height: 1.5;
}

/* =========================================
   FORM
========================================= */
.auth-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.auth-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.auth-field label {
    color: #777;
    font-family: monospace;
    font-size: .65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
}

.auth-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1px solid #292929;
    border-radius: 9px;
    background: #090909;
    color: #eee;
    font-size: .85rem;
    transition: border-color .2s ease, box-shadow .2s ease;
}

.auth-field input::placeholder {
    color: #444;
}

.auth-field input:focus {
    outline: none;
    border-color: rgba(0,245,255,.45);
    box-shadow: 0 0 0 3px rgba(0,245,255,.08);
}

/* =========================================
   REMEMBER ME CHECKBOX
========================================= */
.auth-remember {
    margin-top: -6px;
}

.auth-checkbox-label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
    font-family: inherit;
    font-size: inherit;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    color: inherit;
}

.auth-checkbox-label input[type="checkbox"] {
    display: none;
}

.auth-checkbox-custom {
    width: 18px;
    height: 18px;
    border: 1px solid #444;
    border-radius: 4px;
    background: #090909;
    display: grid;
    place-items: center;
    transition: all .2s ease;
    flex-shrink: 0;
}

.auth-checkbox-label input[type="checkbox"]:checked + .auth-checkbox-custom {
    background: #00f5ff;
    border-color: #00f5ff;
}

.auth-checkbox-label input[type="checkbox"]:checked + .auth-checkbox-custom::after {
    content: "✓";
    color: #000;
    font-size: .75rem;
    font-weight: 900;
    line-height: 1;
}

.auth-checkbox-label span:last-child {
    color: #888;
    font-size: .78rem;
}

/* =========================================
   SUBMIT BUTTON
========================================= */
.auth-submit {
    margin-top: 6px;
    padding: 13px 18px;
    border: none;
    border-radius: 9px;
    background: #00f5ff;
    color: #000;
    font-size: .85rem;
    font-weight: 900;
    letter-spacing: .02em;
    cursor: pointer;
    transition: transform .15s ease, box-shadow .2s ease, background .2s ease;
}

.auth-submit:hover {
    background: #4dfaff;
    box-shadow: 0 0 25px rgba(0,245,255,.35);
    transform: translateY(-1px);
}

.auth-submit:active {
    transform: translateY(0);
}

/* =========================================
   FOOTER
========================================= */
.auth-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid #222;
}

.auth-footer a {
    color: #aaa;
    text-decoration: none;
    font-size: .72rem;
    transition: color .2s ease;
}

.auth-footer a:hover {
    color: #00f5ff;
}

.auth-footer span {
    color: #555;
    font-size: .68rem;
}

/* =========================================
   MODALS (Pure CSS :target)
========================================= */
.auth-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    display: none;
    place-items: center;
    z-index: 100;
    padding: 24px;
}

/* Show modal when its ID is in the URL hash */
.auth-modal:target {
    display: grid;
}

.auth-modal-content {
    position: relative;
    width: 100%;
    max-width: 420px;
    padding: 40px 34px;
    border: 1px solid rgba(0,245,255,.16);
    border-radius: 15px;
    background: #0f0f12;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    animation: modalIn 0.3s ease;
}

@keyframes modalIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.auth-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255,255,255,0.05);
    color: #888;
    text-decoration: none;
    font-size: 1.2rem;
    transition: all 0.2s ease;
}

.auth-modal-close:hover {
    background: rgba(255,92,122,0.15);
    color: #ff6680;
}

.auth-modal h2 {
    margin: 0 0 10px;
    font-size: 1.5rem;
    color: #fff;
}

.auth-modal p {
    margin: 0 0 24px;
    color: #858585;
    font-size: 0.85rem;
    line-height: 1.5;
}

/* =========================================
   RESPONSIVE
========================================= */
@media (max-width: 480px) {
    .auth-card, .auth-modal-content {
        padding: 32px 22px;
    }
    .auth-footer {
        justify-content: center;
        text-align: center;
    }
}
</style>