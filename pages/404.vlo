</BaseLayout>

<style>
.not-found-container {
    text-align: center;
    padding: 100px 20px;
    max-width: 600px;
    margin: 0 auto;
}
.glow-code {
    font-size: 7.5rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, #00f5ff, #00ff88);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 25px rgba(0, 245, 255, 0.3));
}
.not-found-container h2 {
    font-size: 2rem;
    color: #fff;
    margin-bottom: 12px;
}
.not-found-container p {
    color: #888;
    margin-bottom: 30px;
