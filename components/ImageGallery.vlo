{if images}
  <div class="image-gallery">
    <!-- Pure CSS Zoom Toggle -->
    <input type="checkbox" id="zoom-{{ images|hash }}" class="zoom-toggle">
    
    <div class="gallery-main">
      {for img in images}
        <input type="radio" name="gallery-{{ images|hash }}" id="gallery-img-{{ @index }}" class="gallery-radio" {if @first}checked{/if}>
        <label for="gallery-img-{{ @index }}" class="gallery-slide">
          {{ img | image:"w=800,h=800,webp,blur,sizes=(max-width: 800px) 100vw, 800px" }}
          
          <!-- 🔥 TINY DOWNLOAD BUTTON -->
          {if download}
            <a href="/storage/uploads/{{ img }}" download class="gallery-download-btn" title="Download Image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
          {/if}
        </label>
      {/for}
      
      <!-- Trigger -->
      <label for="zoom-{{ images|hash }}" class="zoom-btn">Click to Zoom</label>
    </div>

    {if images.1}
      <div class="gallery-thumbs">
        {for img in images}
          <label for="gallery-img-{{ @index }}" class="thumb-btn">
            {{ img | image:"w=160,h=160,webp" }}
          </label>
        {/for}
      </div>
    {/if}
  </div>
{else}
  <div class="image-gallery">
    <div class="gallery-main">
      <div class="prod-image-placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <path d="M21 15l-5-5L5 21" />
        </svg>
      </div>
    </div>
  </div>
{/if}

<style>
.image-gallery{display:flex;flex-direction:column;gap:16px;width:100%}
.zoom-toggle{display:none}
.gallery-main{position:relative;aspect-ratio:1/1;background:#050505;border:1px solid #232323;border-radius:16px;overflow:hidden;box-shadow:0 12px 32px -8px rgba(0,0,0,.6);isolation:isolate;z-index:0}
.gallery-radio{display:none}
.gallery-slide{position:absolute;inset:0;opacity:0;transition:opacity .4s ease,visibility .4s ease;visibility:hidden;display:grid;place-items:center;z-index:0}
.gallery-slide picture,.gallery-slide img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s cubic-bezier(.25,1,.5,1)}
.gallery-radio:checked+.gallery-slide{opacity:1;visibility:visible;z-index:1}
/* 🔥 DOWNLOAD BUTTON */
.gallery-download-btn{position:absolute;top:16px;right:16px;z-index:20;width:36px;height:36px;display:grid;place-items:center;background:rgba(0,0,0,.6);color:#fff;border-radius:8px;backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.1);opacity:0;transform:translateY(-4px);transition:all .2s ease;text-decoration:none}
.gallery-main:hover .gallery-download-btn{opacity:1;transform:translateY(0)}
.gallery-download-btn:hover{background:#00f5ff;color:#000;border-color:#00f5ff}
.zoom-btn{position:absolute;bottom:16px;right:16px;background:rgba(0,0,0,.6);color:#fff;padding:8px 14px;border-radius:8px;cursor:zoom-in;z-index:10;font-size:.8rem;font-weight:600;backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.1);opacity:0;transform:translateY(4px);transition:all .2s ease}
.gallery-main:hover .zoom-btn{opacity:1;transform:translateY(0)}
/* ─── Active Zoom State (Lowered z-index to sit BELOW modals) ─── */
.zoom-toggle:checked~.gallery-main .gallery-radio:checked+.gallery-slide{position:fixed;inset:0;z-index:900;background:rgba(0,0,0,.95);opacity:1;visibility:visible;backdrop-filter:blur(8px);cursor:zoom-out}
.zoom-toggle:checked~.gallery-main .gallery-radio:checked+.gallery-slide picture{display:flex;align-items:center;justify-content:center;width:100%;height:100%}
.zoom-toggle:checked~.gallery-main .gallery-radio:checked+.gallery-slide img{max-width:95vw;max-height:95vh;width:auto;height:auto;object-fit:contain;transform:none!important;border-radius:4px;box-shadow:0 24px 64px rgba(0,0,0,.8)}
.zoom-toggle:checked~.gallery-main .gallery-radio:checked+.gallery-slide .gallery-download-btn{display:none}
.zoom-toggle:checked~.gallery-main .zoom-btn{position:fixed;top:24px;right:24px;bottom:auto;opacity:1;transform:none;z-index:901;cursor:zoom-out;background:rgba(255,255,255,.1);font-size:0}
.zoom-toggle:checked~.gallery-main .zoom-btn::after{content:"✕";font-size:1.2rem}
/* ─── Hover & Thumbs ─── */
.gallery-radio:checked+.gallery-slide:hover img{transform:scale(1.06)}
.zoom-toggle:checked~.gallery-main .gallery-radio:checked+.gallery-slide:hover img{transform:none!important}
.gallery-thumbs{display:flex;gap:12px;overflow-x:auto;scroll-behavior:smooth;scroll-snap-type:x mandatory;padding-bottom:6px;scrollbar-width:none;-ms-overflow-style:none}
.gallery-thumbs::-webkit-scrollbar{display:none}
.thumb-btn{flex:0 0 80px;height:80px;scroll-snap-align:start;border:2px solid transparent;border-radius:10px;overflow:hidden;cursor:pointer;opacity:.45;background:#111;transition:opacity .25s ease,transform .25s ease,border-color .25s ease}
.thumb-btn picture,.thumb-btn img{width:100%;height:100%;object-fit:cover;display:block}
.thumb-btn:hover{opacity:.9;transform:translateY(-3px)}
.image-gallery:has(.gallery-radio:nth-of-type(1):checked) .thumb-btn:nth-child(1),.image-gallery:has(.gallery-radio:nth-of-type(2):checked) .thumb-btn:nth-child(2),.image-gallery:has(.gallery-radio:nth-of-type(3):checked) .thumb-btn:nth-child(3),.image-gallery:has(.gallery-radio:nth-of-type(4):checked) .thumb-btn:nth-child(4),.image-gallery:has(.gallery-radio:nth-of-type(5):checked) .thumb-btn:nth-child(5),.image-gallery:has(.gallery-radio:nth-of-type(6):checked) .thumb-btn:nth-child(6),.image-gallery:has(.gallery-radio:nth-of-type(7):checked) .thumb-btn:nth-child(7),.image-gallery:has(.gallery-radio:nth-of-type(8):checked) .thumb-btn:nth-child(8),.image-gallery:has(.gallery-radio:nth-of-type(9):checked) .thumb-btn:nth-child(9),.image-gallery:has(.gallery-radio:nth-of-type(10):checked) .thumb-btn:nth-child(10){opacity:1;border-color:#00f5ff;transform:translateY(-2px);box-shadow:0 6px 16px rgba(0,245,255,.2)}
.prod-image-placeholder{color:#2a2a2a;display:grid;place-items:center;width:100%;height:100%;background:radial-gradient(circle at 50% 50%,#111 0%,#050505 100%)}
@media(max-width:768px){.gallery-main{border-radius:12px}.thumb-btn{flex:0 0 64px;height:64px;border-radius:8px}.gallery-thumbs{gap:8px}.zoom-btn,.gallery-download-btn{opacity:1;transform:translateY(0)}}
</style>