<a href="{{href}}" class="vlo-link {{variant}} {{class}}" {{attributes}}>{{text}}</a>
<style>
.vlo-link{background:#00f5ff;color:#000;padding:12px 24px;border-radius:8px;font-weight:bold;text-decoration:none;display:inline-block;text-align:center;transition:all .2s}.vlo-link:hover{transform:translateY(-2px);box-shadow:0 4px 15px rgba(0,245,255,.3)}.vlo-link.secondary{background:transparent;color:#00f5ff;border:2px solid #00f5ff}.vlo-link.ghost{background:transparent;color:#aaa}
</style>