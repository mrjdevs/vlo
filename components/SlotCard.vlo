        </slot>
    </div>
</div>

<style>
.slot-card{background:#111;border:1px solid #333;border-radius:10px;padding:20px;margin:20px 0;color:#eee}
.slot-header{color:#00f5ff;font-size:1.2rem;font-weight:bold;margin-bottom:15px}
