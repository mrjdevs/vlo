<input type="{{type}}" placeholder="{{placeholder}}" class="vlo-input {{class}}" {{attributes}} />
<style>
.vlo-input{background:#111;border:2px solid #333;color:#eee;padding:12px 16px;border-radius:8px;width:100%;font-size:1rem;transition:border 0.2s}.vlo-input:focus{outline:none;border-color:#00f5ff;box-shadow:0 0 0 3px rgba(0,245,255,.1)}
</style>