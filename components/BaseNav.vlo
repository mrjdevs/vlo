<Navbar 
    brand="{{brand}}" 
    brandHref="{{brandHref}}" 
    variant="{{variant}}" 
    size="{{size}}" 
    shadow="{{shadow}}"
    class="sticky collapse {{class}}"
    subtitle="{{subtitle}}"
>
    <a href="/">Home</a>
    <a href="/components">Components</a>
    <a href="/pricing">Pricing</a>
    <a href="/about">About</a>
    <a href="/docs">Docs</a>
    {if logged_in}
        <a href="/products">Products</a>
        <a href="/admin/">Admin</a>
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/shop" class="cart-link">🛒 Cart - 
            <span class="cart-count">
                {{ "" | ajax:"/api/cart_count,0,data.0.total,json" }}
            </span>
        <a href="/api/auth/logout">Logout ({{user_name}})</a>
    {else}
        <a href="/login">Login</a>
    {/if}
</Navbar>
