<Navbar 
    brand="{{brand}}" 
    brandHref="{{brandHref}}" 
    variant="{{variant}}" 
    size="{{size}}" 
    shadow="{{shadow}}"
    class="sticky collapse {{class}}"
    subtitle="{{subtitle}}"
>
    <a href="/">Home</a>
    <a href="/components">Components</a>
    <a href="/pricing">Pricing</a>
    <a href="/about">About</a>
    <a href="/docs">Docs</a>
    {if logged_in}
        <a href="/products">Products</a>
        <div class="nav-item">
            <a href="/admin/">Admin</a>
            <div class="nav-sub">
                <a href="/admin/dashboard">Dashboard</a>
            </div>
        </div>
        <a href="/shop" class="cart-link">🛒 Cart - 
            <span class="cart-count">
                {{ "" | ajax:"/api/cart_count,0,data.0.total,json" }}
            </span>
        </a>
        <form data-vlo-post="/api/auth/logout" style="display:inline">
            <button type="submit" class="nav-logout" style="background:none;border:none;color:inherit;cursor:pointer;font:inherit;padding:0">Logout ({{user_name}})</button>
        </form>
    {else}
        <a href="/login">Login</a>
    {/if}

</Navbar>
