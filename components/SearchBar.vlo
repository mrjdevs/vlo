<form class="vlo-search-bar {if variant == 'inline'}vlo-search-inline{/if}" method="get" action="">
    <div class="vlo-search-wrap">
        <span class="vlo-search-icon">🔍</span>
        <input 
            type="text" 
            name="search" 
            class="vlo-search-input" 
            placeholder="{{placeholder}}" 
            value="{{search}}"
            autocomplete="off"
        />
        {if search}
            <a href="?{if sort}sort={{sort}}&order={{order}}{/if}{if limit}&limit={{limit}}{/if}" class="vlo-search-clear">✕</a>
        {/if}
        {if variant == "inline"}
            <button type="submit" class="vlo-search-btn-inline">{{button_text}}</button>
        {/if}
    </div>
    {if columns}
        <input type="hidden" name="_columns" value="{{columns}}" />
    {/if}
    {if sort}
        <input type="hidden" name="sort" value="{{sort}}" />
    {/if}
    {if order}
        <input type="hidden" name="order" value="{{order}}" />
    {/if}
    {if limit}
        <input type="hidden" name="limit" value="{{limit}}" />
    {/if}
    {if variant != "inline"}
        <button type="submit" class="vlo-search-btn">{{button_text}}</button>
    {/if}
</form>

<style>
.vlo-search-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
.vlo-search-wrap { position: relative; display: flex; align-items: center; flex: 1; max-width: 400px; }
.vlo-search-icon { position: absolute; left: 12px; font-size: 0.85rem; opacity: 0.5; pointer-events: none; }
.vlo-search-input { width: 100%; padding: 10px 36px 10px 36px; border: 1px solid var(--border, #292929); border-radius: 8px; background: var(--surface, #111); color: var(--text, #eee); font-size: 0.82rem; outline: none; transition: border-color 0.2s ease; }
.vlo-search-input:focus { border-color: var(--primary, #00f5ff); box-shadow: 0 0 0 2px rgba(0, 245, 255, 0.1); }
.vlo-search-input::placeholder { color: #555; }
.vlo-search-clear { position: absolute; right: 10px; color: #666; text-decoration: none; font-size: 0.75rem; padding: 4px; border-radius: 4px; transition: color 0.2s; line-height: 1; }
.vlo-search-clear:hover { color: #ff4444; }
.vlo-search-btn { padding: 10px 18px; border: 1px solid var(--primary, #00f5ff); border-radius: 8px; background: transparent; color: var(--primary, #00f5ff); font-size: 0.78rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; white-space: nowrap; }
.vlo-search-btn:hover { background: var(--primary, #00f5ff); color: #000; }

/* ─── Inline variant ─── */
.vlo-search-inline .vlo-search-wrap { max-width: 100%; }
.vlo-search-inline .vlo-search-input { padding-right: 90px; }
.vlo-search-inline .vlo-search-clear { right: 70px; }
.vlo-search-btn-inline { position: absolute; right: 6px; padding: 6px 14px; border: none; border-radius: 6px; background: var(--primary, #00f5ff); color: #000; font-size: 0.72rem; font-weight: 700; cursor: pointer; transition: all 0.15s ease; white-space: nowrap; }
.vlo-search-btn-inline:hover { background: #00d4dd; }
</style>