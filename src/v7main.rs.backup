static VLO_DEBUG: LazyLock<bool> = LazyLock::new(|| {
    std::env::var("VLO_DEBUG")
        .map(|value| env_bool_from_value(&value))
        .unwrap_or(false)
});

fn env_bool_from_value(value: &str) -> bool {
    matches!(
        value.trim().to_ascii_lowercase().as_str(),
        "1" | "true" | "yes" | "on"
    )
}

