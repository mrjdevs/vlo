<Navbar 
    brand="{{brand}}" 
    brandHref="{{brandHref}}" 
    variant="{{variant}}" 
    size="{{size}}" 
    shadow="{{shadow}}"
    class="sticky collapse {{class}}"
>
    <a href="/">Home</a>
    <a href="/components">Components</a>
    <a href="/pricing">Pricing</a>
    <a href="/about">About</a>
    <a href="/docs">Docs</a>
    {if logged_in}
        <a href="/dashboard">Dashboard</a>
        <a href="/api/auth/logout">Logout ({{user_name}})</a>
    {else}
        <a href="/login">Login</a>
    {/if}
</Navbar>
