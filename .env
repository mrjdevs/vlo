APP_ENV=development
VLO_DEBUG=true
PROJECT_ROOT=D:/Programming/vlo
VLO_MAX_UPLOAD_MB=1

VLO_HOST=127.0.0.1
VLO_PORT=3000

ROOT=http://localhost:3000/
RUST_BACKTRACE=1
VLO_FEATURES=auth,database,api,modules,email,sse,files,flash,pagination,directives
AUTH_API_PUBLIC_ROUTES=/api/products,/api/user,/api/get_monthly_products,/api/get_stock_status,/api/get_price_distribution,/api/get_category_stats

# Session behavior
AUTH_SESSION_LIFETIME=86400
AUTH_COOKIE=vlo_session



DB_DRIVER=sqlite
DATABASE_URL=sqlite://vlo_app.db
# DB_SCHEMA not set → defaults to "schema.sql"

# For PostgreSQL
#DATABASE_URL=postgres://user:pass@localhost/vlo_app
#DB_DRIVER=postgres
#DB_SCHEMA=schema.postgres.sql

# For MySQL
#DATABASE_URL=mysql://user:pass@localhost/vlo_app
#DB_DRIVER=mysql
#DB_SCHEMA=schema.mysql.sql

#RUST_BACKTRACE=1
#DB_DRIVER=postgres
#DATABASE_URL=postgres://localhost:5432
#DATABASE_URL=postgres://df75b61ed0a9cdf3f3ef3c3ef3af9a5f99bd27956cbb966a62c5b0f88c7f82a0:sk_VmsuA2u6D2wzvNSFw0ZZG@pooled.db.prisma.io:5432/postgres?sslmode=require
#DB_DRIVER=mysql
#DATABASE_URL=mysql://username:password@server:3306/database

# ---------------------------------------------------------------------------
# VLO Authentication Column Mapping
# ---------------------------------------------------------------------------

# User table / columns
AUTH_USER_TABLE=users
AUTH_USER_ID=id
AUTH_USER_NAME=name
AUTH_USER_IDENTIFIER=email
AUTH_USER_PASSWORD=password_hash
AUTH_USER_ROLE=role
AUTH_USER_STATUS=status

# Session table / columns
AUTH_SESSION_TABLE=sessions
AUTH_SESSION_TOKEN=token
AUTH_SESSION_USER_ID=user_id
AUTH_SESSION_EXPIRES_AT=expires_at

