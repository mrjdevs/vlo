#DB_DRIVER=mysql
#DATABASE_URL=mysql://username:password@server:3306/database

# ---------------------------------------------------------------------------
# VLO Authentication Column Mapping
# ---------------------------------------------------------------------------

# User table / columns
AUTH_USER_TABLE=users
AUTH_USER_ID=id
AUTH_USER_NAME=name
AUTH_USER_IDENTIFIER=email
AUTH_USER_PASSWORD=password_hash
AUTH_USER_ROLE=role


# Session table / columns
AUTH_SESSION_TABLE=sessions
AUTH_SESSION_TOKEN=token
AUTH_SESSION_USER_ID=user_id
AUTH_SESSION_EXPIRES_AT=expires_at

# Session behavior
AUTH_SESSION_LIFETIME=86400
AUTH_COOKIE=vlo_session

AUTH_API_PUBLIC_ROUTES=/api/products,/api/categories
