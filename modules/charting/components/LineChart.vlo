<div class="vlo-chart vlo-chart-line" style="--chart-color: {{color | default:'#00f5ff'}}">
  {if title}
    <div class="vlo-chart-header">
      <h4 class="vlo-chart-title">{{title}}</h4>
      <div class="vlo-chart-summary">
        <span class="vlo-chart-stat">
          <span class="vlo-chart-stat-label">Total</span>
          <span class="vlo-chart-stat-value">{{meta.total | number:2}}</span>
        </span>
        <span class="vlo-chart-stat">
          <span class="vlo-chart-stat-label">Average</span>
          <span class="vlo-chart-stat-value">{{meta.avg_value | number:2}}</span>
        </span>
      </div>
    </div>
  {/if}

  <div class="vlo-chart-body vlo-chart-line-body">
    <!-- Tooltip Container -->
    <div class="vlo-line-tooltip"></div>

    <svg viewBox="0 0 400 200" preserveAspectRatio="none" class="vlo-line-svg">
      <line x1="30" y1="20" x2="370" y2="20" stroke="#292929" stroke-width="0.5"/>
      <line x1="30" y1="65" x2="370" y2="65" stroke="#292929" stroke-width="0.5"/>
      <line x1="30" y1="110" x2="370" y2="110" stroke="#292929" stroke-width="0.5"/>
      <line x1="30" y1="155" x2="370" y2="155" stroke="#292929" stroke-width="0.5"/>

      <path class="vlo-line-area" fill="var(--chart-color)" opacity="0.08"/>
      <path class="vlo-line-path" fill="none" stroke="var(--chart-color)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>

      {for point in data}
        <circle class="vlo-line-point"
                data-value="{{point.value}}"
                data-label="{{point.label}}"
                r="4"
                fill="var(--chart-color)"
                stroke="#0a0a0f"
                stroke-width="2"/>
      {/for}
    </svg>

    <div class="vlo-line-labels"></div>
  </div>

  {if !data}
    <div class="vlo-chart-empty"><p>No data available</p></div>
  {/if}
</div>