<div class="vlo-chart vlo-chart-bar" style="--chart-color: {{color}}">
  {if title}
    <div class="vlo-chart-header">
      <h4 class="vlo-chart-title">{{title}}</h4>
      <div class="vlo-chart-summary">
        <span class="vlo-chart-stat"><span class="vlo-chart-stat-label">Total</span><span class="vlo-chart-stat-value">{{meta.total}}</span></span>
        <span class="vlo-chart-stat"><span class="vlo-chart-stat-label">Items</span><span class="vlo-chart-stat-value">{{meta.series_count}}</span></span>
      </div>
    </div>
  {/if}

  <div class="vlo-chart-body">
    {for point in data}
      <div class="vlo-bar-wrapper">
        <div class="vlo-bar-value">{{point.value}}</div>
        <div class="vlo-bar-track"><div class="vlo-bar-fill" style="height: {{point.percentage}}%"></div></div>
        <div class="vlo-bar-label">{if point.label}{{point.label}}{else}Other{/if}</div>
      </div>
    {/for}
  </div>

  {if !data}
    <div class="vlo-chart-empty"><p>No data available</p></div>
  {/if}
</div>